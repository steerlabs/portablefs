VOLUME_DATABASE_URL=postgres://postgres:postgres@localhost:5432/portablefs

# Fill these from:
# railway bucket credentials --bucket portablefs-blobs --json
VOLUME_RAILWAY_BUCKET_ENDPOINT=https://t3.storageapi.dev
VOLUME_RAILWAY_BUCKET_NAME=portablefs-blobs-xxxxxx
VOLUME_RAILWAY_BUCKET_REGION=auto
VOLUME_RAILWAY_BUCKET_URL_STYLE=virtual-host
VOLUME_RAILWAY_BUCKET_ACCESS_KEY_ID=
VOLUME_RAILWAY_BUCKET_SECRET_ACCESS_KEY=
VOLUME_RAILWAY_BUCKET_PREFIX=portablefs/dev
