# node:22-bookworm
FROM node:26-bookworm@sha256:219fc9da91e7f29a9f32290ff598cdf8886fd68f421ff515c8f93434da39a271 AS build
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/volume-worker/package.json apps/volume-worker/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/metadata-db/package.json packages/metadata-db/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/storage-filesystem/package.json packages/storage-filesystem/package.json
COPY packages/storage-s3/package.json packages/storage-s3/package.json
RUN pnpm install --frozen-lockfile --filter @portablefs/volume-worker...

COPY apps/volume-worker apps/volume-worker
COPY packages/core packages/core
COPY packages/metadata-db packages/metadata-db
COPY packages/protocol packages/protocol
COPY packages/storage-filesystem packages/storage-filesystem
COPY packages/storage-s3 packages/storage-s3
RUN pnpm --filter @portablefs/volume-worker... build

# node:22-bookworm-slim
FROM node:26-bookworm-slim@sha256:2d49d876e96237d76de412761cf05dbfe5aee325cc4406a4d41d5824c5bb8beb AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/volume-worker/package.json apps/volume-worker/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/metadata-db/package.json packages/metadata-db/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/storage-filesystem/package.json packages/storage-filesystem/package.json
COPY packages/storage-s3/package.json packages/storage-s3/package.json
RUN pnpm install --prod --frozen-lockfile --filter @portablefs/volume-worker...

COPY --from=build /app/apps/volume-worker/dist apps/volume-worker/dist
COPY --from=build /app/packages/core/dist packages/core/dist
COPY --from=build /app/packages/metadata-db/dist packages/metadata-db/dist
COPY --from=build /app/packages/metadata-db/migrations packages/metadata-db/migrations
COPY --from=build /app/packages/metadata-db/migrations packages/migrations
COPY --from=build /app/packages/protocol/dist packages/protocol/dist
COPY --from=build /app/packages/storage-filesystem/dist packages/storage-filesystem/dist
COPY --from=build /app/packages/storage-s3/dist packages/storage-s3/dist

# Declared for release-build symmetry (the worker serves no identity route);
# keeps the shared build-args invocation warning-free.
ARG PORTABLEFS_RELEASE_ID=""
ARG PORTABLEFS_SOURCE_REVISION=""

ENV NODE_ENV=production
WORKDIR /app/apps/volume-worker

# Unprivileged runtime: the integrity job only reads /app (root-owned,
# world-readable) and talks to the database/bucket; it writes no local data.
USER node

CMD ["node", "dist/main.js", "integrity"]
