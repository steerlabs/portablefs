-	dentry = lookup_open(nd, file, op, got_write);
-	if (!IS_ERR(dentry)) {
-		if (file->f_mode & FMODE_CREATED)
-			fsnotify_create(dir->d_inode, dentry);
-		if (file->f_mode & FMODE_OPENED)
-			fsnotify_open(file);
+	{
+		struct fs_reply_publish_scope publish_scope;
+		ssize_t publish_result;
+		bool merge_attempted = false;
+
+		if (!*open_publish_entered) {
+			/* `dir` is the final parent after all mount/symlink walks. */
+			fs_reply_publish_scope_enter(open_publish_scope,
+						     dir->d_sb);
+			*open_publish_entered = true;
+		}
+
+		fs_reply_publish_scope_enter(&publish_scope, dir->d_sb);
+		dentry = lookup_open(nd, file, op, got_write);
+		if (!IS_ERR(dentry)) {
+			if (file->f_mode & FMODE_CREATED)
+				fsnotify_create(dir->d_inode, dentry);
+			if (file->f_mode & FMODE_OPENED)
+				fsnotify_open(file);
+		}
+		if (!IS_ERR(dentry) &&
+		    (file->f_mode & (FMODE_OPENED | FMODE_CREATED)) &&
+		    fs_reply_publish_scope_has_tokens(&publish_scope)) {
+			struct fs_reply_publish_token *token;
+
+			/* CREATE is durable even if a later post-open hook fails. */
+			list_for_each_entry(token, &publish_scope.tokens, link)
+				token->publish_on_operation_error = true;
+			merge_attempted = true;
+			publish_result = fs_reply_publish_scope_merge(
+				open_publish_scope, &publish_scope);
+		} else {
+			publish_result = fs_reply_publish_scope_finish(
+				&publish_scope,
+				IS_ERR(dentry) ? PTR_ERR(dentry) : 0);
+		}
+		if ((merge_attempted && publish_result) ||
+		    publish_result == -ENOTCONN ||
+		    publish_result == -EPROTO) {
+			/* A failed merge leaves the child scope live: unwind both. */
+			if (current->fs_reply_publish_scope == &publish_scope)
+				fs_reply_publish_scope_abort(&publish_scope);
+			if (*open_publish_entered &&
