From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tim Jang <timjang3@gmail.com>
Date: Thu, 13 Aug 2026 08:30:38 -0700
Subject: [PATCH 1/2] fs: add post-VFS reply publication scopes

---
 fs/Makefile                      |   1 +
 fs/aio.c                         |  32 ++++-
 fs/attr.c                        |  12 +-
 fs/namei.c                       | 219 +++++++++++++++++++++++++++----
 fs/open.c                        |   8 +-
 fs/read_write.c                  | 205 ++++++++++++++++++++++++-----
 fs/reply_publish.c               | 200 ++++++++++++++++++++++++++++
 fs/splice.c                      | 101 +++++++++++---
 fs/xattr.c                       |  15 ++-
 include/linux/fs.h               |   7 +-
 include/linux/fs_reply_publish.h |  84 ++++++++++++
 include/linux/sched.h            |   4 +
 io_uring/rw.c                    |  74 ++++++++++-
 kernel/fork.c                    |   1 +
 14 files changed, 876 insertions(+), 87 deletions(-)
 create mode 100644 fs/reply_publish.c
 create mode 100644 include/linux/fs_reply_publish.h

diff --git a/fs/Makefile b/fs/Makefile
index 61679fd58..eb6001cef 100644
--- a/fs/Makefile
+++ b/fs/Makefile
@@ -11,6 +11,7 @@ obj-y :=	open.o read_write.o file_table.o super.o \
 		char_dev.o stat.o exec.o pipe.o namei.o fcntl.o \
 		ioctl.o readdir.o select.o dcache.o inode.o \
 		attr.o bad_inode.o file.o filesystems.o namespace.o \
+		reply_publish.o \
 		seq_file.o xattr.o libfs.o fs-writeback.o \
 		pnode.o splice.o sync.o utimes.o d_path.o \
 		stack.o fs_struct.o statfs.o fs_pin.o nsfs.o \
diff --git a/fs/aio.c b/fs/aio.c
index e8920178b..0f8767575 100644
--- a/fs/aio.c
+++ b/fs/aio.c
@@ -24,6 +24,8 @@
 
 #include <linux/sched/signal.h>
 #include <linux/fs.h>
+#include <linux/fs_reply_publish.h>
+#include <linux/fsnotify.h>
 #include <linux/file.h>
 #include <linux/mm.h>
 #include <linux/mman.h>
@@ -1607,9 +1609,12 @@ static int aio_read(struct kiocb *req, const struct iocb *iocb,
 static int aio_write(struct kiocb *req, const struct iocb *iocb,
 			 bool vectored, bool compat)
 {
+	struct fs_reply_publish_scope publish_scope;
 	struct iovec inline_vecs[UIO_FASTIOV], *iovec = inline_vecs;
 	struct iov_iter iter;
 	struct file *file;
+	u64 applied_bytes;
+	ssize_t io_result;
 	int ret;
 
 	ret = aio_prep_rw(req, iocb, WRITE);
@@ -1630,9 +1635,34 @@ static int aio_write(struct kiocb *req, const struct iocb *iocb,
 		if (S_ISREG(file_inode(file)->i_mode))
 			kiocb_start_write(req);
 		req->ki_flags |= IOCB_WRITE;
-		aio_rw_done(req, file->f_op->write_iter(req, &iter));
+		fs_reply_publish_scope_enter_write(&publish_scope,
+					   file_inode(file)->i_sb);
+		io_result = file->f_op->write_iter(req, &iter);
+		/* Strict PortableFS transactions are synchronous by contract. */
+		if (io_result == -EIOCBQUEUED &&
+		    fs_reply_publish_scope_has_tokens(&publish_scope)) {
+			fs_reply_publish_scope_abort(&publish_scope);
+			io_result = -ENOTCONN;
+		} else if (io_result != -EIOCBQUEUED) {
+			if (fs_reply_publish_scope_has_tokens(&publish_scope) &&
+			    req->ki_flags & IOCB_WRITE &&
+			    S_ISREG(file_inode(file)->i_mode)) {
+				kiocb_end_write(req);
+				req->ki_flags &= ~IOCB_WRITE;
+			}
+			if (fs_reply_publish_scope_has_tokens(&publish_scope) &&
+			    fs_reply_publish_write_applied(io_result,
+							   &applied_bytes))
+				fsnotify_modify(file);
+			io_result = fs_reply_publish_scope_finish(&publish_scope,
+							       io_result);
+		} else {
+			fs_reply_publish_scope_abort(&publish_scope);
+		}
+		aio_rw_done(req, io_result);
 	}
 	kfree(iovec);
+	/* Completion is now arranged; io_submit must not destroy req again. */
 	return ret;
 }
 
diff --git a/fs/attr.c b/fs/attr.c
index c04d19b58..69135b751 100644
--- a/fs/attr.c
+++ b/fs/attr.c
@@ -13,6 +13,7 @@
 #include <linux/sched/signal.h>
 #include <linux/capability.h>
 #include <linux/fsnotify.h>
+#include <linux/fs_reply_publish.h>
 #include <linux/fcntl.h>
 #include <linux/filelock.h>
 #include <linux/security.h>
@@ -377,6 +378,8 @@ EXPORT_SYMBOL(may_setattr);
 int notify_change(struct mnt_idmap *idmap, struct dentry *dentry,
 		  struct iattr *attr, struct inode **delegated_inode)
 {
+	struct fs_reply_publish_scope publish_scope;
+	bool publish_started = false;
 	struct inode *inode = dentry->d_inode;
 	umode_t mode = inode->i_mode;
 	int error;
@@ -499,15 +502,20 @@ int notify_change(struct mnt_idmap *idmap, struct dentry *dentry,
 			return error;
 	}
 
-	if (inode->i_op->setattr)
+	if (inode->i_op->setattr) {
+		fs_reply_publish_scope_enter(&publish_scope, inode->i_sb);
+		publish_started = true;
 		error = inode->i_op->setattr(idmap, dentry, attr);
-	else
+	} else {
 		error = simple_setattr(idmap, dentry, attr);
+	}
 
 	if (!error) {
 		fsnotify_change(dentry, ia_valid);
 		security_inode_post_setattr(idmap, dentry, ia_valid);
 	}
+	if (publish_started)
+		error = fs_reply_publish_scope_finish(&publish_scope, error);
 
 	return error;
 }
diff --git a/fs/namei.c b/fs/namei.c
index ffa68aa99..ab50f1c96 100644
--- a/fs/namei.c
+++ b/fs/namei.c
@@ -25,6 +25,7 @@
 #include <linux/pagemap.h>
 #include <linux/sched/mm.h>
 #include <linux/fsnotify.h>
+#include <linux/fs_reply_publish.h>
 #include <linux/personality.h>
 #include <linux/security.h>
 #include <linux/syscalls.h>
@@ -869,10 +870,22 @@ static bool try_to_unlazy_next(struct nameidata *nd, struct dentry *dentry)
 
 static inline int d_revalidate(struct dentry *dentry, unsigned int flags)
 {
-	if (unlikely(dentry->d_flags & DCACHE_OP_REVALIDATE))
-		return dentry->d_op->d_revalidate(dentry, flags);
-	else
+	if (unlikely(dentry->d_flags & DCACHE_OP_REVALIDATE)) {
+		struct fs_reply_publish_scope scope;
+		int status;
+
+		/* RCU walk may not invalidate dentries or wait for PUBLISH. */
+		if (flags & LOOKUP_RCU)
+			return dentry->d_op->d_revalidate(dentry, flags);
+		fs_reply_publish_scope_enter(&scope, dentry->d_sb);
+		status = dentry->d_op->d_revalidate(dentry, flags);
+		if (!status)
+			d_invalidate(dentry);
+		status = fs_reply_publish_scope_finish(&scope, status);
+		return status < 0 ? status : !!status;
+	} else {
 		return 1;
+	}
 }
 
 /**
@@ -1608,8 +1621,6 @@ static struct dentry *lookup_dcache(const struct qstr *name,
 	if (dentry) {
 		int error = d_revalidate(dentry, flags);
 		if (unlikely(error <= 0)) {
-			if (!error)
-				d_invalidate(dentry);
 			dput(dentry);
 			return ERR_PTR(error);
 		}
@@ -1631,6 +1642,8 @@ struct dentry *lookup_one_qstr_excl(const struct qstr *name,
 	struct dentry *dentry = lookup_dcache(name, base, flags);
 	struct dentry *old;
 	struct inode *dir = base->d_inode;
+	struct fs_reply_publish_scope publish_scope;
+	ssize_t publish_result;
 
 	if (dentry)
 		return dentry;
@@ -1643,11 +1656,19 @@ struct dentry *lookup_one_qstr_excl(const struct qstr *name,
 	if (unlikely(!dentry))
 		return ERR_PTR(-ENOMEM);
 
+	fs_reply_publish_scope_enter(&publish_scope, dir->i_sb);
 	old = dir->i_op->lookup(dir, dentry, flags);
 	if (unlikely(old)) {
 		dput(dentry);
 		dentry = old;
 	}
+	publish_result = fs_reply_publish_scope_finish(&publish_scope,
+					      IS_ERR(dentry) ? PTR_ERR(dentry) : 0);
+	if (publish_result == -ENOTCONN) {
+		if (!IS_ERR(dentry))
+			dput(dentry);
+		dentry = ERR_PTR(-ENOTCONN);
+	}
 	return dentry;
 }
 EXPORT_SYMBOL(lookup_one_qstr_excl);
@@ -1670,6 +1691,7 @@ static struct dentry *lookup_fast(struct nameidata *nd)
 {
 	struct dentry *dentry, *parent = nd->path.dentry;
 	int status = 1;
+	bool rcu_zero = false;
 
 	/*
 	 * Rename seqlock is not required here because in the off chance
@@ -1694,11 +1716,14 @@ static struct dentry *lookup_fast(struct nameidata *nd)
 		status = d_revalidate(dentry, nd->flags);
 		if (likely(status > 0))
 			return dentry;
+		rcu_zero = !status;
 		if (!try_to_unlazy_next(nd, dentry))
 			return ERR_PTR(-ECHILD);
-		if (status == -ECHILD)
