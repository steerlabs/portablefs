@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_FS_REPLY_PUBLISH_H
+#define _LINUX_FS_REPLY_PUBLISH_H
+
+#include <linux/list.h>
+#include <linux/types.h>
+
+struct super_block;
+
+/*
+ * A filesystem reply may make a remote result durable before the VFS has
+ * finished publishing the corresponding dentry, inode, cache, or file
+ * position.  A reply token is therefore attached to the exact stack-scoped
+ * VFS operation and acknowledged only at that operation's true publication
+ * point.
+ */
+struct fs_reply_publish_token {
+	struct list_head link;
+	struct super_block *sb;
+	int (*publish)(struct fs_reply_publish_token *token);
+	void (*cancel)(struct fs_reply_publish_token *token);
+	bool publish_on_operation_error;
+};
+
+struct fs_reply_publish_scope {
+	struct fs_reply_publish_scope *parent;
+	struct super_block *sb;
+	struct list_head tokens;
+	u64 write_rlimit_fsize;
+	u64 write_file_max_size;
+	u64 applied_bytes;
+	bool active;
+	bool accepts_write_token;
+	bool write_limits_valid;
+	bool applied_bytes_valid;
+};
+
+void fs_reply_publish_scope_enter(struct fs_reply_publish_scope *scope,
+				  struct super_block *sb);
+bool fs_reply_publish_scope_enter_if_needed(
+		struct fs_reply_publish_scope *scope, struct super_block *sb);
+bool fs_reply_publish_scope_enter_write(
+		struct fs_reply_publish_scope *scope, struct super_block *sb);
+int fs_reply_publish_scope_flush(struct fs_reply_publish_scope *scope);
+void fs_reply_publish_scope_abort(struct fs_reply_publish_scope *scope);
+ssize_t fs_reply_publish_scope_finish(struct fs_reply_publish_scope *scope,
+				       ssize_t result);
+int fs_reply_publish_add_to(struct fs_reply_publish_scope *scope,
+			    struct fs_reply_publish_token *token);
+int fs_reply_publish_scope_merge(struct fs_reply_publish_scope *parent,
+				 struct fs_reply_publish_scope *child);
+int fs_reply_publish_add(struct fs_reply_publish_token *token);
+bool fs_reply_publish_scope_requires_flush(
+		const struct fs_reply_publish_scope *scope);
+void fs_reply_publish_scope_set_write_limits(u64 rlimit_fsize,
+					     u64 file_max_size);
+bool fs_reply_publish_scope_get_write_limits(u64 *rlimit_fsize,
+					     u64 *file_max_size);
+void fs_reply_publish_scope_set_applied_bytes(u64 applied_bytes);
+bool fs_reply_publish_scope_get_applied_bytes(u64 *applied_bytes);
+
+/*
+ * A reply may have committed bytes and then reported a post-apply error.
+ * Callers use this independently of the externally visible return value so
+ * position, fsnotify, and accounting are published exactly once before ACK.
+ */
+static inline bool fs_reply_publish_write_applied(ssize_t result,
+						  u64 *applied_bytes)
+{
+	if (result > 0) {
+		*applied_bytes = result;
+		return true;
+	}
+	return fs_reply_publish_scope_get_applied_bytes(applied_bytes) &&
+	       *applied_bytes;
+}
+
+static inline bool
+fs_reply_publish_scope_has_tokens(const struct fs_reply_publish_scope *scope)
+{
+	return scope->active && !list_empty(&scope->tokens);
+}
+
+#endif /* _LINUX_FS_REPLY_PUBLISH_H */
