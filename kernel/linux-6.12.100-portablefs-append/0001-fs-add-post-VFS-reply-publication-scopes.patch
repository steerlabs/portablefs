diff --git a/fs/reply_publish.c b/fs/reply_publish.c
new file mode 100644
index 000000000..767d8f0c2
--- /dev/null
+++ b/fs/reply_publish.c
@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/export.h>
+#include <linux/fs.h>
+#include <linux/fs_reply_publish.h>
+#include <linux/sched.h>
+
+void fs_reply_publish_scope_enter(struct fs_reply_publish_scope *scope,
+				  struct super_block *sb)
+{
+	scope->parent = current->fs_reply_publish_scope;
+	scope->sb = sb;
+	INIT_LIST_HEAD(&scope->tokens);
+	scope->active = !!(sb && (sb->s_iflags & SB_I_REPLY_PUBLISH));
+	scope->accepts_write_token = false;
+	scope->write_limits_valid = false;
+	scope->applied_bytes_valid = false;
+	current->fs_reply_publish_scope = scope;
+}
+
+bool fs_reply_publish_scope_enter_write(
+		struct fs_reply_publish_scope *scope, struct super_block *sb)
+{
+	struct fs_reply_publish_scope *current_scope =
+		current->fs_reply_publish_scope;
+
+	if (current_scope && current_scope->active &&
+	    current_scope->sb == sb && current_scope->accepts_write_token)
+		return false;
+	fs_reply_publish_scope_enter(scope, sb);
+	scope->accepts_write_token = scope->active;
+	return true;
+}
+
+bool fs_reply_publish_scope_enter_if_needed(
+		struct fs_reply_publish_scope *scope, struct super_block *sb)
+{
+	if (current->fs_reply_publish_scope &&
+	    current->fs_reply_publish_scope->active &&
+	    current->fs_reply_publish_scope->sb == sb)
+		return false;
+	fs_reply_publish_scope_enter(scope, sb);
+	return true;
+}
+
+static void fs_reply_publish_scope_leave(struct fs_reply_publish_scope *scope)
+{
+	WARN_ON_ONCE(current->fs_reply_publish_scope != scope);
+	current->fs_reply_publish_scope = scope->parent;
+	scope->active = false;
+}
+
+void fs_reply_publish_scope_abort(struct fs_reply_publish_scope *scope)
+{
+	struct fs_reply_publish_token *token, *next;
+
+	list_for_each_entry_safe(token, next, &scope->tokens, link) {
+		list_del_init(&token->link);
+		token->cancel(token);
+	}
+	fs_reply_publish_scope_leave(scope);
+}
+
+int fs_reply_publish_scope_flush(struct fs_reply_publish_scope *scope)
+{
+	struct fs_reply_publish_token *token;
+	int err = 0;
+
+	while (!list_empty(&scope->tokens)) {
+		token = list_first_entry(&scope->tokens,
+					 struct fs_reply_publish_token, link);
+		list_del_init(&token->link);
+		err = token->publish(token);
+		if (err)
+			break;
+	}
+	if (err) {
+		struct fs_reply_publish_token *next;
+
+		list_for_each_entry_safe(token, next, &scope->tokens, link) {
+			list_del_init(&token->link);
+			token->cancel(token);
+		}
+	}
+	/*
+	 * A later token failure must fence every mutation represented by this
+	 * scope, even though earlier token ACKs may already be physical.  The
+	 * connection abort is the terminal result; callers must not retry.
+	 */
+	fs_reply_publish_scope_leave(scope);
+	return err;
+}
+
+ssize_t fs_reply_publish_scope_finish(struct fs_reply_publish_scope *scope,
+				       ssize_t result)
+{
+	bool has_tokens = fs_reply_publish_scope_has_tokens(scope);
+	bool publish_after_error =
+		fs_reply_publish_scope_requires_flush(scope);
+	int err;
+
+	if (result >= 0 || publish_after_error) {
+		err = fs_reply_publish_scope_flush(scope);
+		return err ? -ENOTCONN : result;
+	}
+
+	fs_reply_publish_scope_abort(scope);
+	/* A definite marked mutation followed by local failure is ambiguous. */
+	return has_tokens ? -ENOTCONN : result;
+}
+
+int fs_reply_publish_add_to(struct fs_reply_publish_scope *scope,
+			    struct fs_reply_publish_token *token)
+{
+	if (!scope || !scope->active || scope->sb != token->sb ||
+	    !list_empty(&token->link))
+		return -EPROTO;
+	list_add_tail(&token->link, &scope->tokens);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(fs_reply_publish_add_to);
+
+int fs_reply_publish_scope_merge(struct fs_reply_publish_scope *parent,
+				 struct fs_reply_publish_scope *child)
+{
+	/* Non-participating filesystems still need to unwind the stack scope. */
+	if (!child->active) {
+		if (current->fs_reply_publish_scope != child ||
+		    child->parent != parent || !list_empty(&child->tokens))
+			return -EPROTO;
+		fs_reply_publish_scope_leave(child);
+		return 0;
+	}
+	if (!child->active || child->parent != parent || !parent ||
+	    !parent->active || parent->sb != child->sb)
+		return -EPROTO;
+	list_splice_tail_init(&child->tokens, &parent->tokens);
+	fs_reply_publish_scope_leave(child);
+	return 0;
+}
+
+int fs_reply_publish_add(struct fs_reply_publish_token *token)
+{
+	return fs_reply_publish_add_to(current->fs_reply_publish_scope, token);
+}
+EXPORT_SYMBOL_GPL(fs_reply_publish_add);
+
+bool fs_reply_publish_scope_requires_flush(
+		const struct fs_reply_publish_scope *scope)
+{
+	const struct fs_reply_publish_token *token;
+
+	list_for_each_entry(token, &scope->tokens, link)
+		if (token->publish_on_operation_error)
+			return true;
+	return false;
+}
+
+void fs_reply_publish_scope_set_write_limits(u64 rlimit_fsize,
+					     u64 file_max_size)
+{
+	struct fs_reply_publish_scope *scope = current->fs_reply_publish_scope;
+
+	if (!scope || !scope->active)
+		return;
+	scope->write_rlimit_fsize = rlimit_fsize;
+	scope->write_file_max_size = file_max_size;
+	scope->write_limits_valid = true;
+}
+
+bool fs_reply_publish_scope_get_write_limits(u64 *rlimit_fsize,
+					     u64 *file_max_size)
+{
+	struct fs_reply_publish_scope *scope = current->fs_reply_publish_scope;
+
+	if (!scope || !scope->active || !scope->write_limits_valid)
+		return false;
+	*rlimit_fsize = scope->write_rlimit_fsize;
+	*file_max_size = scope->write_file_max_size;
+	return true;
+}
+
+void fs_reply_publish_scope_set_applied_bytes(u64 applied_bytes)
+{
+	struct fs_reply_publish_scope *scope = current->fs_reply_publish_scope;
+
+	if (!scope || !scope->active)
+		return;
+	scope->applied_bytes = applied_bytes;
+	scope->applied_bytes_valid = true;
+}
+
+bool fs_reply_publish_scope_get_applied_bytes(u64 *applied_bytes)
+{
+	struct fs_reply_publish_scope *scope = current->fs_reply_publish_scope;
+
+	if (!scope || !scope->active || !scope->applied_bytes_valid)
+		return false;
+	*applied_bytes = scope->applied_bytes;
+	return true;
+}
