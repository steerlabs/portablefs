+			rcu_zero = false;
+		}
 	} else {
 		dentry = __d_lookup(parent, &nd->last);
 		if (unlikely(!dentry))
@@ -1706,7 +1731,8 @@ static struct dentry *lookup_fast(struct nameidata *nd)
 		status = d_revalidate(dentry, nd->flags);
 	}
 	if (unlikely(status <= 0)) {
-		if (!status)
+		/* The RCU callback returned zero before we acquired references. */
+		if (!status && rcu_zero)
 			d_invalidate(dentry);
 		dput(dentry);
 		return ERR_PTR(status);
@@ -1734,7 +1760,6 @@ static struct dentry *__lookup_slow(const struct qstr *name,
 		int error = d_revalidate(dentry, flags);
 		if (unlikely(error <= 0)) {
 			if (!error) {
-				d_invalidate(dentry);
 				dput(dentry);
 				goto again;
 			}
@@ -1742,8 +1767,20 @@ static struct dentry *__lookup_slow(const struct qstr *name,
 			dentry = ERR_PTR(error);
 		}
 	} else {
+		struct fs_reply_publish_scope publish_scope;
+		ssize_t publish_result;
+
+		fs_reply_publish_scope_enter(&publish_scope, inode->i_sb);
 		old = inode->i_op->lookup(inode, dentry, flags);
 		d_lookup_done(dentry);
+		publish_result = fs_reply_publish_scope_finish(&publish_scope,
+						 IS_ERR(old) ? PTR_ERR(old) : 0);
+		if (publish_result == -ENOTCONN) {
+			dput(dentry);
+			if (old && !IS_ERR(old))
+				dput(old);
+			return ERR_PTR(-ENOTCONN);
+		}
 		if (unlikely(old)) {
 			dput(dentry);
 			dentry = old;
@@ -3298,6 +3335,7 @@ static inline umode_t vfs_prepare_mode(struct mnt_idmap *idmap,
