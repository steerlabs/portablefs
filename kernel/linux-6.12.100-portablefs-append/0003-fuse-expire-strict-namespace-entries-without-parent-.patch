From 769357494594e02dc2c29401f82c147a6069eaff Mon Sep 17 00:00:00 2001
From: Tim Jang <timjang3@gmail.com>
Date: Sat, 15 Aug 2026 22:12:43 -0700
Subject: [PATCH] fuse: expire strict namespace entries without parent lock

---
 fs/fuse/dir.c | 84 +++++++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 74 insertions(+), 10 deletions(-)

diff --git a/fs/fuse/dir.c b/fs/fuse/dir.c
index f11b829cc..7ee120772 100644
--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -11,6 +11,7 @@
 #include <linux/pagemap.h>
 #include <linux/file.h>
 #include <linux/fs_context.h>
+#include <linux/fsnotify.h>
 #include <linux/moduleparam.h>
 #include <linux/sched.h>
 #include <linux/namei.h>
@@ -1577,6 +1578,75 @@ int fuse_update_attributes(struct inode *inode, struct file *file, u32 mask)
 	return fuse_update_get_attr(&nop_mnt_idmap, inode, file, NULL, mask, 0);
 }
 
+/*
+ * Strict namespace repair is expiration, not a synthetic local unlink.  It
+ * must be able to run while an unanswered FUSE namespace operation holds the
+ * parent's i_rwsem, so it deliberately uses only dcache/inode references and
+ * never inode_lock(parent).  Expiring the FUSE entry timeout is sufficient to
+ * make the cached binding unservable: the next path walk must revalidate it
+ * through LOOKUP.  A DELETE notification additionally emits the exact watcher
+ * event, but does not clear nlink or detach mounts for a mutation performed on
+ * another machine.
+ */
+static int fuse_pfs_reverse_expire_entry(struct fuse_conn *fc,
+					 u64 parent_nodeid, u64 child_nodeid,
+					 struct qstr *name)
+{
+	struct inode *parent;
+	struct inode *child = NULL;
+	struct dentry *dir;
+	struct dentry *entry;
+	int err = -ENOENT;
+
+	parent = fuse_ilookup(fc, parent_nodeid, NULL);
+	if (!parent)
+		return -ENOENT;
+	if (!S_ISDIR(parent->i_mode) ||
+	    get_fuse_inode(parent)->pfs_class != FUSE_PFS_CLASS_SHARED) {
+		err = -EPROTO;
+		goto out_parent;
+	}
+	dir = d_find_alias(parent);
+	if (!dir)
+		goto out_parent;
+
+	name->hash = full_name_hash(dir, name->name, name->len);
+	entry = d_lookup(dir, name);
+	dput(dir);
+	if (!entry)
+		goto out_parent;
+
+	spin_lock(&entry->d_lock);
+	child = d_inode(entry);
+	if (child)
+		ihold(child);
+	spin_unlock(&entry->d_lock);
+	if (child && (get_fuse_inode(child)->pfs_class != FUSE_PFS_CLASS_SHARED ||
+		      (child_nodeid && get_node_id(child) != child_nodeid))) {
+		err = -EPROTO;
+		goto out_entry;
+	}
+
+	fuse_dir_changed(parent);
+	fuse_invalidate_entry_cache(entry);
+	if (child_nodeid && child) {
+		__u32 mask = FS_DELETE;
+
+		if (S_ISDIR(child->i_mode))
+			mask |= FS_ISDIR;
+		fsnotify_name(mask, child, FSNOTIFY_EVENT_INODE, parent, name, 0);
+	}
+	err = 0;
+
+out_entry:
+	if (child)
+		iput(child);
+	dput(entry);
+out_parent:
+	iput(parent);
+	return err;
+}
+
 int fuse_reverse_inval_entry(struct fuse_conn *fc, u64 parent_nodeid,
 			     u64 child_nodeid, struct qstr *name, u32 flags)
 {
@@ -1585,6 +1655,10 @@ int fuse_reverse_inval_entry(struct fuse_conn *fc, u64 parent_nodeid,
 	struct dentry *dir;
 	struct dentry *entry;
 
+	if (fc->pfs_strict_coherence)
+		return fuse_pfs_reverse_expire_entry(fc, parent_nodeid,
+						     child_nodeid, name);
+
 	parent = fuse_ilookup(fc, parent_nodeid, NULL);
 	if (!parent)
 		return -ENOENT;
@@ -1603,15 +1677,6 @@ int fuse_reverse_inval_entry(struct fuse_conn *fc, u64 parent_nodeid,
 	dput(dir);
 	if (!entry)
 		goto unlock;
-	if (fc->pfs_strict_coherence && d_really_is_positive(entry) &&
-	    (get_fuse_inode(d_inode(entry))->pfs_class !=
-					FUSE_PFS_CLASS_SHARED ||
-	     (child_nodeid &&
-	      get_node_id(d_inode(entry)) != child_nodeid))) {
-		err = -EPROTO;
-		goto out_entry;
-	}
-
 	fuse_dir_changed(parent);
 	if (!(flags & FUSE_EXPIRE_ONLY))
 		d_invalidate(entry);
@@ -1646,7 +1711,6 @@ int fuse_reverse_inval_entry(struct fuse_conn *fc, u64 parent_nodeid,
 		err = 0;
 	}
 
- out_entry:
 	dput(entry);
 
  unlock:
-- 
2.53.0

