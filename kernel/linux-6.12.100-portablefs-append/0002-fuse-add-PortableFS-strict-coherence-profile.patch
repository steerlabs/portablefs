+			return false;
+		return new_size > in->rlimit_fsize;
+	}
+
+	if (!fuse_pfs_fallocate_end_growth_mode(in->mode))
+		return false;
+	/* xfs_falloc_newsize() invokes inode_newsize_ok only for growth. */
+	return pre_size < end && end > in->rlimit_fsize;
+}
