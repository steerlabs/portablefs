+static int fuse_pfs_validate_range_out(const struct fuse_pfs_range_out *out,
+				       bool allow_noop,
+				       bool rlimit_carries_pre_size,
+				       enum fuse_pfs_range_outcome *outcome)
+{
+	*outcome = FUSE_PFS_RANGE_OUTCOME_INVALID;
+	if (out->flags == FUSE_PFS_RANGE_OUT_REJECTED ||
+	    out->flags == FUSE_PFS_RANGE_OUT_REJECTED_RLIMIT) {
+		if (out->result_size || out->sequence ||
+		    out->error >= 0 || out->error < -MAX_ERRNO ||
+		    (out->flags == FUSE_PFS_RANGE_OUT_REJECTED &&
+		     out->post_size) ||
+		    (out->flags == FUSE_PFS_RANGE_OUT_REJECTED_RLIMIT &&
+		     !rlimit_carries_pre_size && out->post_size) ||
+		    (out->flags == FUSE_PFS_RANGE_OUT_REJECTED_RLIMIT &&
+		     out->error != -EFBIG))
