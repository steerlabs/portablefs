+static int fuse_pfs_write_control(struct kiocb *iocb,
+				  const struct fuse_pfs_write_in *frozen,
+				  u32 phase, u64 staged_size,
+				  bool allow_rejected,
+				  struct fuse_pfs_write_out *out,
+				  enum fuse_pfs_write_outcome *outcome,
+				  struct fs_reply_publish_token **publish_token)
+{
+	struct fuse_file *ff = iocb->ki_filp->private_data;
+	struct fuse_pfs_write_in in = *frozen;
+	struct fuse_args args = {
+		.opcode = FUSE_PFS_WRITE,
+		.nodeid = ff->nodeid,
+		.in_numargs = 1,
+		.out_numargs = 1,
+	};
+	u32 expected;
+	int err;
+
+	*outcome = FUSE_PFS_WRITE_OUTCOME_INVALID;
+	if (publish_token)
+		*publish_token = NULL;
+	memset(out, 0, sizeof(*out));
+	in.fragment_offset = phase == FUSE_PFS_WRITE_COMMIT ? staged_size : 0;
+	in.size = 0;
+	in.phase = phase;
+	args.in_args[0].size = sizeof(in);
+	args.in_args[0].value = &in;
+	args.out_args[0].size = sizeof(*out);
+	args.out_args[0].value = out;
+	if (phase == FUSE_PFS_WRITE_COMMIT || phase == FUSE_PFS_WRITE_ABORT) {
+		args.force = true;
+		args.nocreds = phase == FUSE_PFS_WRITE_ABORT;
+	}
+	if (phase == FUSE_PFS_WRITE_COMMIT)
+		args.pfs_publish_policy = FUSE_PFS_PUBLISH_OPTIONAL;
+
+	err = fuse_simple_request(ff->fm, &args);
+	if (err)
+		return err;
+	switch (phase) {
+	case FUSE_PFS_WRITE_BEGIN:
+		expected = FUSE_PFS_WRITE_OUT_BEGUN;
+		break;
+	case FUSE_PFS_WRITE_COMMIT:
+		expected = FUSE_PFS_WRITE_OUT_COMMITTED;
+		break;
+	case FUSE_PFS_WRITE_ABORT:
+		expected = FUSE_PFS_WRITE_OUT_ABORTED;
+		break;
+	default:
+		return -EPROTO;
+	}
+	err = fuse_pfs_validate_write_out(out, frozen->txid, expected,
+					  allow_rejected, outcome);
+	if (phase == FUSE_PFS_WRITE_COMMIT) {
+		bool committed =
+			*outcome == FUSE_PFS_WRITE_OUTCOME_COMMITTED ||
+			*outcome == FUSE_PFS_WRITE_OUTCOME_POSTAPPLY_ERROR;
+
+		if (fuse_pfs_require_publication(ff->fm, &args, committed)) {
+			*outcome = FUSE_PFS_WRITE_OUTCOME_INVALID;
+			return -ENOTCONN;
+		}
+		if (committed) {
+			if (WARN_ON_ONCE(!args.pfs_reply_token)) {
+				*outcome = FUSE_PFS_WRITE_OUTCOME_INVALID;
+				return -EPROTO;
+			}
+			if (publish_token)
+				*publish_token = args.pfs_reply_token;
+		}
+	}
+	return err;
+}
+
+static void fuse_pfs_write_abort(struct kiocb *iocb,
+				 const struct fuse_pfs_write_in *frozen)
+{
+	struct fuse_file *ff = iocb->ki_filp->private_data;
+	struct fuse_pfs_write_out out;
+	enum fuse_pfs_write_outcome outcome;
+	int err;
+
+	/* BEGIN/DATA are inert; cleanup is best effort and idempotent. */
+	err = fuse_pfs_write_control(iocb, frozen, FUSE_PFS_WRITE_ABORT, 0,
+				     false, &out, &outcome, NULL);
+	if (err == -EPROTO)
+		fuse_abort_conn(ff->fm->fc);
+}
