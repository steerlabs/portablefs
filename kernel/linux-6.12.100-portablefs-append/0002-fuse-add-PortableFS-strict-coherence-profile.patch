+			FUSE_PFS_RANGE_OUTCOME_REJECTED_RLIMIT :
+			FUSE_PFS_RANGE_OUTCOME_REJECTED;
+		return 0;
+	}
+	if (out->flags == FUSE_PFS_RANGE_OUT_NOOP) {
+		if (!allow_noop || out->result_size || out->post_size ||
+		    out->sequence || out->error)
+			return -EPROTO;
+		*outcome = FUSE_PFS_RANGE_OUTCOME_NOOP;
+		return 0;
+	}
