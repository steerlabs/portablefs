+enum fuse_pfs_write_outcome {
+	FUSE_PFS_WRITE_OUTCOME_INVALID,
+	FUSE_PFS_WRITE_OUTCOME_ACK,
+	FUSE_PFS_WRITE_OUTCOME_COMMITTED,
+	FUSE_PFS_WRITE_OUTCOME_POSTAPPLY_ERROR,
+	FUSE_PFS_WRITE_OUTCOME_REJECTED,
+	FUSE_PFS_WRITE_OUTCOME_REJECTED_RLIMIT,
+};
+
+static int fuse_pfs_validate_write_out(const struct fuse_pfs_write_out *out,
+				       u64 txid, u32 expected,
+				       bool allow_rejected,
+				       enum fuse_pfs_write_outcome *outcome)
+{
+	*outcome = FUSE_PFS_WRITE_OUTCOME_INVALID;
+	if (out->txid != txid)
+		return -EPROTO;
+	if (out->flags == FUSE_PFS_WRITE_OUT_REJECTED ||
+	    out->flags == FUSE_PFS_WRITE_OUT_REJECTED_RLIMIT) {
+		if (!allow_rejected || out->error >= 0 ||
+		    out->error < -MAX_ERRNO || out->committed_size ||
+		    out->assigned_offset || out->post_size || out->sequence ||
+		    (out->flags == FUSE_PFS_WRITE_OUT_REJECTED_RLIMIT &&
+		     out->error != -EFBIG))
+			return -EPROTO;
+		*outcome = out->flags == FUSE_PFS_WRITE_OUT_REJECTED_RLIMIT ?
+			FUSE_PFS_WRITE_OUTCOME_REJECTED_RLIMIT :
+			FUSE_PFS_WRITE_OUTCOME_REJECTED;
+		return out->error;
+	}
+	if (expected == FUSE_PFS_WRITE_OUT_COMMITTED) {
+		if (out->flags == (FUSE_PFS_WRITE_OUT_COMMITTED |
+				   FUSE_PFS_WRITE_OUT_POSTAPPLY_ERROR)) {
+			if (out->error >= 0 || out->error < -MAX_ERRNO)
+				return -EPROTO;
+		} else if (out->flags != FUSE_PFS_WRITE_OUT_COMMITTED ||
+			   out->error) {
+			return -EPROTO;
+		}
+	} else if (out->flags != expected) {
+		return -EPROTO;
+	}
+	if (expected != FUSE_PFS_WRITE_OUT_COMMITTED &&
+	    (out->error || out->committed_size || out->assigned_offset ||
+	     out->post_size || out->sequence))
+		return -EPROTO;
+	if (out->flags == (FUSE_PFS_WRITE_OUT_COMMITTED |
+			  FUSE_PFS_WRITE_OUT_POSTAPPLY_ERROR))
+		*outcome = FUSE_PFS_WRITE_OUTCOME_POSTAPPLY_ERROR;
+	else if (out->flags == FUSE_PFS_WRITE_OUT_COMMITTED)
+		*outcome = FUSE_PFS_WRITE_OUTCOME_COMMITTED;
+	else
+		*outcome = FUSE_PFS_WRITE_OUTCOME_ACK;
+	return 0;
+}
