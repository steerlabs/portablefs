+static u64 fuse_pfs_rlimit_fsize(void)
+{
+	/* Raw 64-bit rlim_cur: U64_MAX is infinity and zero is a real limit. */
+	return rlimit(RLIMIT_FSIZE);
+}
+
+static ssize_t fuse_pfs_positioned_checks(struct kiocb *iocb,
+					  struct iov_iter *from,
+					  u64 rlimit_fsize,
+					  u64 file_max_size)
+{
+	struct inode *inode = file_inode(iocb->ki_filp);
+	u64 pos;
+	u64 count = iov_iter_count(from);
+
+	if (IS_SWAPFILE(inode))
+		return -ETXTBSY;
+	if (!count)
+		return 0;
+	if (iocb->ki_pos < 0)
+		return -EINVAL;
+	if (iocb->ki_flags & IOCB_NOWAIT)
+		return -EAGAIN;
+
+	pos = iocb->ki_pos;
+	if (pos >= rlimit_fsize) {
+		send_sig(SIGXFSZ, current, 0);
+		return -EFBIG;
+	}
+	count = min(count, rlimit_fsize - pos);
+	if (pos >= file_max_size)
+		return -EFBIG;
+	count = min(count, file_max_size - pos);
+	iov_iter_truncate(from, count);
+	return iov_iter_count(from);
+}
