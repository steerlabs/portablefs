+static u32 fuse_pfs_operation_flags(const struct kiocb *iocb)
+{
+	u32 flags = 0;
+
+	if (iocb->ki_flags & IOCB_APPEND)
+		flags |= O_APPEND;
+	if (iocb_is_dsync(iocb))
+		flags |= O_DSYNC;
+	if (iocb->ki_flags & IOCB_SYNC)
+		flags |= O_SYNC;
+	return flags;
