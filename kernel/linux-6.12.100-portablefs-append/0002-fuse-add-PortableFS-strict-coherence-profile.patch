+static u64 fuse_pfs_file_max_end(const struct file *file)
+{
+	u64 max_end = file_inode(file)->i_sb->s_maxbytes;
+
+	if (!(file->f_flags & O_LARGEFILE))
+		max_end = min_t(u64, max_end, MAX_NON_LFS);
+	return max_end;
+}
