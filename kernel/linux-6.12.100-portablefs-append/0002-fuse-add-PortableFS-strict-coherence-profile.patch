+			  FUSE_PFS_RANGE_OUT_POSTAPPLY_ERROR)) {
+		if (out->error >= 0 || out->error < -MAX_ERRNO)
+			return -EPROTO;
+		*outcome = FUSE_PFS_RANGE_OUTCOME_POSTAPPLY_ERROR;
+	} else if (out->flags == FUSE_PFS_RANGE_OUT_APPLIED) {
+		if (out->error)
