+		.fh = ff->fh,
+		.txid = txid,
+		.requested_size = requested_size,
+		.position = position,
+		.rlimit_fsize = rlimit_fsize,
+		.file_max_size = file_max_size,
+		.flags = fuse_pfs_operation_flags(iocb),
+		.phase = FUSE_PFS_WRITE_BEGIN,
