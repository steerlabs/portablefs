 /*
@@ -289,8 +303,20 @@ static void fuse_dev_queue_req(struct fuse_iqueue *fiq, struct fuse_req *req)
 {
 	spin_lock(&fiq->lock);
 	if (fiq->connected) {
-		if (req->in.h.opcode != FUSE_NOTIFY_REPLY)
+		if (req->in.h.opcode != FUSE_NOTIFY_REPLY) {
 			req->in.h.unique = fuse_get_unique_locked(fiq);
+			if (unlikely(!req->in.h.unique)) {
+				struct fuse_conn *fc =
+					container_of(fiq, struct fuse_conn, iq);
+
+				spin_unlock(&fiq->lock);
+				fuse_abort_conn(fc);
+				req->out.h.error = -EOVERFLOW;
+				clear_bit(FR_PENDING, &req->flags);
+				fuse_request_end(req);
+				return;
+			}
+		}
 		list_add_tail(&req->list, &fiq->pending);
 		fuse_dev_wake_and_unlock(fiq);
 	} else {
@@ -360,6 +386,19 @@ void fuse_request_end(struct fuse_req *req)
 	if (test_and_set_bit(FR_FINISHED, &req->flags))
 		goto put_request;
 
+	/*
+	 * The strict profile has no daemon-ENOSYS compatibility path.  Every
+	 * operation which is intentionally local or unsupported is decided before
+	 * a request is queued.  Seeing ENOSYS here therefore proves that the
+	 * negotiated, indivisible protocol was not implemented by the daemon.
+	 * Apply the rule here so synchronous and background requests cannot drift
+	 * into separate no_* fallback policies.
+	 */
+	if (fc->pfs_strict_coherence && req->out.h.error == -ENOSYS) {
+		req->out.h.error = -ENOTCONN;
+		fuse_abort_conn(fc);
+	}
+
 	trace_fuse_request_end(req);
 	/*
 	 * test_and_set_bit() implies smp_mb() between bit
@@ -540,6 +579,69 @@ static void fuse_args_to_req(struct fuse_req *req, struct fuse_args *args)
 		__set_bit(FR_ASYNC, &req->flags);
 }
 
+static int fuse_pfs_publish_token_send(struct fs_reply_publish_token *token)
+{
+	struct fuse_req *original = container_of(token, struct fuse_req,
+						pfs_publish_token);
+	struct fuse_mount *fm = original->fm;
+	struct fuse_conn *fc = fm->fc;
+	struct fuse_pfs_publish_in in = {
+		.request_unique = original->in.h.unique & ~FUSE_UNIQUE_RESEND,
+		.nodeid = original->in.h.nodeid,
+		.opcode = original->in.h.opcode,
+	};
+	struct fuse_pfs_publish_out out = {};
+	struct fuse_args args = {
+		.opcode = FUSE_PFS_PUBLISH,
+		.nodeid = original->in.h.nodeid,
+		.in_numargs = 1,
+		.out_numargs = 1,
+		.force = true,
+		.nocreds = true,
+	};
+	s64 publication_id;
+	int err;
+
+	/* Normal FUSE request IDs are even (FUSE_REQ_ID_STEP == 2). */
+	publication_id = atomic64_add_return(2, &fc->pfs_publication_id);
+	if (unlikely(publication_id <= 0)) {
+		err = -EOVERFLOW;
+		goto abort;
+	}
+	in.publication_id = publication_id;
+	args.in_args[0].size = sizeof(in);
+	args.in_args[0].value = &in;
+	args.out_args[0].size = sizeof(out);
+	args.out_args[0].value = &out;
+
+	err = fuse_simple_request(fm, &args);
+	if (err)
+		goto abort;
+	if (out.request_unique != in.request_unique ||
+	    out.publication_id != in.publication_id ||
+	    out.nodeid != in.nodeid || out.opcode != in.opcode ||
+	    out.flags != FUSE_PFS_PUBLISH_ACK) {
+		err = -EPROTO;
+		goto abort;
+	}
+	fuse_put_request(original);
+	return 0;
+
+abort:
+	fuse_abort_conn(fc);
+	fuse_put_request(original);
+	return err;
+}
+
+static void fuse_pfs_publish_token_cancel(struct fs_reply_publish_token *token)
+{
+	struct fuse_req *req = container_of(token, struct fuse_req,
+					   pfs_publish_token);
+
+	fuse_abort_conn(req->fm->fc);
+	fuse_put_request(req);
+}
+
 ssize_t __fuse_simple_request(struct mnt_idmap *idmap,
 			      struct fuse_mount *fm,
 			      struct fuse_args *args)
@@ -547,6 +649,7 @@ ssize_t __fuse_simple_request(struct mnt_idmap *idmap,
 	struct fuse_conn *fc = fm->fc;
 	struct fuse_req *req;
 	ssize_t ret;
+	bool reply_success;
 
 	if (args->force) {
 		atomic_inc(&fc->num_waiting);
@@ -565,17 +668,75 @@ ssize_t __fuse_simple_request(struct mnt_idmap *idmap,
 	}
 
 	/* Needs to be done after fuse_get_req() so that fc->minor is valid */
+	args->pfs_reply_marked = false;
+	args->pfs_reply_token = NULL;
 	fuse_adjust_compat(fc, args);
 	fuse_args_to_req(req, args);
+	if (fc->pfs_strict_coherence &&
+	    args->pfs_publish_policy != FUSE_PFS_PUBLISH_FORBID) {
+		struct fs_reply_publish_scope *scope =
+			current->fs_reply_publish_scope;
+
+		/* A publication-bearing operation must name its final VFS edge. */
+		if (args->end || !scope || !scope->active ||
+		    scope->sb != fm->sb) {
+			fuse_abort_conn(fc);
+			fuse_put_request(req);
+			return -ENOTCONN;
+		}
+		req->pfs_publish_scope = scope;
+	}
 
 	if (!args->noreply)
 		__set_bit(FR_ISREPLY, &req->flags);
 	__fuse_request_send(req);
 	ret = req->out.h.error;
+	reply_success = !ret ||
+		(args->opcode == FUSE_LOOKUP && ret == -ENOENT);
 	if (!ret && args->out_argvar) {
 		BUG_ON(args->out_numargs == 0);
 		ret = args->out_args[args->out_numargs - 1].size;
 	}
+	if (fc->pfs_strict_coherence &&
+	    ((args->pfs_reply_marked &&
+	      (!reply_success || args->pfs_publish_policy ==
+				 FUSE_PFS_PUBLISH_FORBID)) ||
+	     (!args->pfs_reply_marked && reply_success &&
+	      args->pfs_publish_policy ==
+				 FUSE_PFS_PUBLISH_REQUIRE_SUCCESS))) {
+		fuse_abort_conn(fc);
+		ret = -ENOTCONN;
+	} else if (reply_success && args->pfs_reply_marked) {
+		struct fs_reply_publish_token *token =
+			&req->pfs_publish_token;
+		struct fs_reply_publish_scope *scope = req->pfs_publish_scope;
+
+		token->sb = fm->sb;
+		token->publish = fuse_pfs_publish_token_send;
+		token->cancel = fuse_pfs_publish_token_cancel;
+		/*
+		 * A marked LOOKUP has installed either a positive or a negative
+		 * namespace fact even when an enclosing open subsequently returns
+		 * an errno.  It must cross the post-dentry publication boundary in
+		 * that case.  Private mutation validators opt in separately, only
+		 * after validating their marked body as a definite applied outcome.
+		 */
+		token->publish_on_operation_error = args->opcode == FUSE_LOOKUP;
+		__fuse_get_request(req);
+		if (scope != current->fs_reply_publish_scope)
+			ret = -EPROTO;
+		else
+			ret = fs_reply_publish_add_to(scope, token);
+		if (ret) {
+			fuse_abort_conn(fc);
+			fuse_put_request(req);
+		} else {
+			args->pfs_reply_token = token;
+		}
+	}
+	/* A retained publication token owns only req/fm and copied headers. */
+	req->pfs_publish_scope = NULL;
+	req->args = NULL;
 	fuse_put_request(req);
 
 	return ret;
@@ -1141,20 +1302,31 @@ static struct fuse_forget_link *fuse_dequeue_forget(struct fuse_iqueue *fiq,
 	return head;
 }
 
-static int fuse_read_single_forget(struct fuse_iqueue *fiq,
