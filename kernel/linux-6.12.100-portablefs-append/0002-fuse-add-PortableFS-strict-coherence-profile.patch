+static bool fuse_pfs_fallocate_rlimit_rejection_valid(
+		const struct fuse_pfs_fallocate_in *in, u64 pre_size, u64 end)
+{
+	u64 new_size;
+
+	if (in->rlimit_fsize == RLIM_INFINITY ||
+	    pre_size > in->file_max_size)
+		return false;
+
+	if (in->mode == FALLOC_FL_INSERT_RANGE) {
+		/* XFS checks the size ceiling and offset before inode_newsize_ok. */
+		if (check_add_overflow(pre_size, in->length, &new_size) ||
