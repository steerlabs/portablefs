+		ret = fuse_direntplus_link(file, &record->entry_out,
+					   record->name, record->namelen,
+					   &record->stamp, attr_version);
+		if (ret) {
+			if (record->entry_out.nodeid)
+				fuse_force_forget(file, record->entry_out.nodeid);
+			buf += reclen;
