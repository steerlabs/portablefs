+	if (!stamp->snapshot_sequence || stamp->snapshot_sequence > S64_MAX ||
+	    stamp->reserved)
+		return -EPROTO;
+	mutex_lock(&fi->pfs_publish_mutex);
+	err = pfs_install_stamped_attr(inode, &out->attr, ATTR_TIMEOUT(out),
+				       stamp);
+	if (err > 0) {
+		out->attr_valid = 0;
+		out->attr_valid_nsec = 0;
+		err = 0;
+	}
+	mutex_unlock(&fi->pfs_publish_mutex);
+	return err;
+}
+
+int fuse_pfs_install_post_state(struct fuse_mount *fm,
+				struct fuse_args *args,
+				struct fuse_pfs_post_state *state,
+				struct inode **inodes, unsigned int inode_count,
+				struct inode *entry_parent,
+				struct fuse_entry_out *entry,
+				u64 data_nodeid, loff_t data_start,
+				u64 data_length)
+{
+	struct fuse_conn *fc = fm->fc;
+	struct pfs_install_record records[FUSE_PFS_MAX_OBJECTS];
+	struct inode *data_inode = NULL;
+	u64 parent_prior = 0;
+	bool parent_found = false;
+	bool entry_install = true;
+	unsigned int count, actual, i;
+	int err = 0;
+
+	if (!fc->pfs_strict_coherence || !args->pfs_reply_marked)
+		return -EPROTO;
+	count = state->header.object_count;
+	actual = args->out_args[args->out_numargs - 1].size;
+	if (!state->header.visibility_sequence ||
+	    state->header.visibility_sequence != state->header.snapshot_sequence ||
+	    state->header.snapshot_sequence > S64_MAX ||
+	    (state->header.attr_valid_ns != 0 &&
+	     state->header.attr_valid_ns != PFS_ATTR_VALID_NS) ||
+	    count < 1 || count > FUSE_PFS_MAX_OBJECTS || state->header.flags ||
+	    actual != sizeof(state->header) +
+		      count * sizeof(state->objects[0]) ||
+	    inode_count != count || !pfs_valid_roles(args->opcode, state))
+		return -EPROTO;
+
+	for (i = 0; i < count; i++) {
+		struct inode *inode = pfs_find_inode(inodes, inode_count,
+						    state->objects[i].nodeid);
+		unsigned int j;
+
+		if (!inode || pfs_validate_record(state, i, inode))
+			return -EPROTO;
+		for (j = 0; j < i; j++)
+			if (state->objects[j].nodeid == state->objects[i].nodeid)
+				return -EPROTO;
+		records[i].inode = inode;
+		records[i].state = &state->objects[i];
+	}
+	sort(records, count, sizeof(records[0]), pfs_inode_cmp, NULL);
+
+	for (i = 0; i < count; i++)
+		if (!i || records[i - 1].inode != records[i].inode)
+			mutex_lock(&get_fuse_inode(records[i].inode)->pfs_publish_mutex);
+	if (data_nodeid) {
+		data_inode = pfs_find_inode(inodes, inode_count, data_nodeid);
+		if (!data_inode || !S_ISREG(data_inode->i_mode)) {
+			err = -EPROTO;
+			goto out_unlock;
+		}
+		filemap_invalidate_lock(data_inode->i_mapping);
+	}
+
+	/*
+	 * NEW-A: this loop is the complete step-3 snapshot.  No version or
+	 * attribute store is permitted until every comparison below has been
+	 * evaluated against the state predating this transaction.
+	 */
+	for (i = 0; i < count; i++) {
+		struct fuse_inode *fi = get_fuse_inode(records[i].inode);
+
+		spin_lock(&fi->lock);
+		records[i].prior_version = fi->pfs_object_version;
+		if (entry_parent &&
+		    (records[i].state->roles & PFS_PARENT_ROLES) &&
+		    records[i].inode == entry_parent) {
+			parent_prior = max(records[i].prior_version,
+					   fi->pfs_entry_repair_sequence);
+			parent_found = true;
+		}
+		spin_unlock(&fi->lock);
+		records[i].install_attr =
+			!(records[i].state->record_flags &
+			  FUSE_PFS_OBJECT_DROP_ATTR) &&
+			records[i].state->object_version >
+			records[i].prior_version;
+	}
+	if (entry_parent) {
+		if (!parent_found) {
+			err = -EPROTO;
+			goto out_data;
+		}
+		if (state->header.snapshot_sequence <= parent_prior)
+			entry_install = false;
+		if (!entry_install && entry) {
+			entry->entry_valid = 0;
+			entry->entry_valid_nsec = 0;
+		}
+	}
+
+	if (data_inode && data_length) {
+		pgoff_t first = data_start >> PAGE_SHIFT;
+		pgoff_t last;
+
+		if (data_start < 0 || data_length - 1 > LLONG_MAX - data_start) {
+			err = -EPROTO;
+			goto out_data;
+		}
+		last = (data_start + data_length - 1) >> PAGE_SHIFT;
+		unmap_mapping_pages(data_inode->i_mapping, first,
+				    last - first + 1, false);
+		err = invalidate_inode_pages2_range(data_inode->i_mapping,
+						    first, last);
+		if (err)
+			goto out_data;
+	}
+
+	for (i = 0; i < count; i++) {
+		struct fuse_pfs_object_state *object = records[i].state;
+		struct inode *inode = records[i].inode;
+		struct fuse_inode *fi = get_fuse_inode(inode);
+
+		if (object->roles & PFS_PARENT_ROLES)
+			inode_maybe_inc_iversion(inode, false);
+		if (!records[i].install_attr)
+			continue;
+		forget_all_cached_acls(inode);
+		spin_lock(&fi->lock);
+		fuse_change_attributes_common(inode, &object->attr, NULL, 0, 0);
+		i_size_write(inode, object->attr.size);
+		pfs_install_exact_attr_locked(inode, object->birth_time_ns,
+					      object->inode_flags);
+		memcpy(fi->pfs_stable_identity, object->stable_identity,
+		       sizeof(fi->pfs_stable_identity));
+		fi->pfs_identity_known = true;
+		fi->attr_version = atomic64_inc_return(&fc->attr_version);
+		fi->pfs_object_version = object->object_version;
+		/* Publish validity only after the complete post-state record. */
+		smp_store_release(&fi->i_time, get_jiffies_64() +
+			nsecs_to_jiffies64(state->header.attr_valid_ns));
+		spin_unlock(&fi->lock);
+	}
+
+out_data:
+	if (data_inode)
+		filemap_invalidate_unlock(data_inode->i_mapping);
+out_unlock:
+	while (count--) {
+		if (!count || records[count - 1].inode != records[count].inode)
+			mutex_unlock(&get_fuse_inode(records[count].inode)->pfs_publish_mutex);
+	}
+	return err;
+}
