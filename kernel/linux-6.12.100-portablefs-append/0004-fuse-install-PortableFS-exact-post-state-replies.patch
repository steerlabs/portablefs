+			   struct inode *inode, int mask);
+
+static int fuse_pfs_permission_attr_exact(struct mnt_idmap *idmap,
+					  struct inode *inode, int mask)
+{
+	struct fuse_conn *fc = get_fuse_conn(inode);
+
+	if (!fc->pfs_strict_coherence ||
+	    get_fuse_inode(inode)->pfs_class != FUSE_PFS_CLASS_SHARED)
+		return fuse_permission(idmap, inode, mask);
+	if (fuse_is_bad(inode))
+		return -EIO;
+	if (!fuse_allow_current_process(fc))
+		return -EACCES;
+	if (!fc->default_permissions)
+		return -EIO;
+	return generic_permission(idmap, inode, mask);
+}
