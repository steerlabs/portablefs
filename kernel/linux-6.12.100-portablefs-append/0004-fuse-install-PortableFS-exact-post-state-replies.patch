+		    !fuse_pfs_local_negative_base(outarg))
+			return FUSE_PFS_LOOKUP_INVALID;
+		if (rule->shape == FUSE_PFS_LOOKUP_SHARED_NEGATIVE &&
+		    !fuse_pfs_shared_negative_base(outarg))
+			return FUSE_PFS_LOOKUP_INVALID;
