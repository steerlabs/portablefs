+/*
+ * Return with pfs_publish_mutex held for a SHARED inode. Refresh is issued
+ * without that mutex because stamped GETATTR installation needs the same
+ * publication boundary.
+ */
+static int fuse_pfs_begin_attr_exact(struct inode *inode)
+{
+	struct fuse_conn *fc = get_fuse_conn(inode);
+	struct fuse_inode *fi = get_fuse_inode(inode);
+	bool refreshed = false;
+	int err;
+
+	if (!fc->pfs_strict_coherence ||
+	    fi->pfs_class != FUSE_PFS_CLASS_SHARED)
+		return 0;
+	for (;;) {
+		mutex_lock(&fi->pfs_publish_mutex);
+		spin_lock(&fi->lock);
+		err = IS_ATTR_EXACT(inode) ? 0 : -EAGAIN;
+		spin_unlock(&fi->lock);
+		if (!err)
+			return 0;
+		mutex_unlock(&fi->pfs_publish_mutex);
+		if (refreshed)
+			return err;
+		err = fuse_perm_getattr(inode, 0);
+		if (err)
+			return err;
+		refreshed = true;
+	}
+}
+
+static void fuse_pfs_end_attr_exact(struct inode *inode)
+{
+	struct fuse_conn *fc = get_fuse_conn(inode);
+	struct fuse_inode *fi = get_fuse_inode(inode);
+
+	if (fc->pfs_strict_coherence &&
+	    fi->pfs_class == FUSE_PFS_CLASS_SHARED)
+		mutex_unlock(&fi->pfs_publish_mutex);
+}
+
+static bool fuse_pfs_shared_inode(struct inode *inode)
+{
+	return get_fuse_conn(inode)->pfs_strict_coherence &&
+		get_fuse_inode(inode)->pfs_class == FUSE_PFS_CLASS_SHARED;
+}
+
+static int fuse_pfs_begin_attr_exact_pair(struct inode *inode,
+					  struct inode *other)
+{
+	struct inode *first = inode;
+	struct inode *second = other;
+	struct fuse_inode *first_fi;
+	struct fuse_inode *second_fi;
+	bool first_shared;
+	bool second_shared;
+	int err = 0;
+
+	if (get_node_id(second) < get_node_id(first)) {
+		first = other;
+		second = inode;
+	}
+	first_fi = get_fuse_inode(first);
+	second_fi = get_fuse_inode(second);
+	first_shared = fuse_pfs_shared_inode(first);
+	second_shared = fuse_pfs_shared_inode(second);
+	if (first_shared)
+		mutex_lock(&first_fi->pfs_publish_mutex);
+	if (second != first && second_shared)
+		mutex_lock_nested(&second_fi->pfs_publish_mutex,
+				  SINGLE_DEPTH_NESTING);
+	if (first_shared) {
+		spin_lock(&first_fi->lock);
+		if (!IS_ATTR_EXACT(first))
+			err = -EAGAIN;
+		spin_unlock(&first_fi->lock);
+	}
+	if (!err && second != first && second_shared) {
+		spin_lock(&second_fi->lock);
+		if (!IS_ATTR_EXACT(second))
+			err = -EAGAIN;
+		spin_unlock(&second_fi->lock);
+	}
+	if (!err)
+		return 0;
+	if (second != first && second_shared)
+		mutex_unlock(&second_fi->pfs_publish_mutex);
+	if (first_shared)
+		mutex_unlock(&first_fi->pfs_publish_mutex);
+	return err;
+}
+
+static void fuse_pfs_end_attr_exact_pair(struct inode *inode,
+					 struct inode *other)
+{
+	struct inode *first = inode;
+	struct inode *second = other;
+
+	if (get_node_id(second) < get_node_id(first)) {
+		first = other;
+		second = inode;
+	}
+	if (second != first && fuse_pfs_shared_inode(second))
+		mutex_unlock(&get_fuse_inode(second)->pfs_publish_mutex);
+	if (fuse_pfs_shared_inode(first))
+		mutex_unlock(&get_fuse_inode(first)->pfs_publish_mutex);
+}
