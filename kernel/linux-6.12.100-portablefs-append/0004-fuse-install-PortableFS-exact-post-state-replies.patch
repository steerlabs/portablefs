diff --git a/fs/attr.c b/fs/attr.c
index 69135b751..61a1d0ddf 100644
--- a/fs/attr.c
+++ b/fs/attr.c
@@ -164,15 +164,19 @@ int setattr_prepare(struct mnt_idmap *idmap, struct dentry *dentry,
 {
 	struct inode *inode = d_inode(dentry);
 	unsigned int ia_valid = attr->ia_valid;
+	int error = inode_begin_attr_exact(inode);
+
+	if (error)
+		return error;
 
 	/*
 	 * First check size constraints.  These can't be overriden using
 	 * ATTR_FORCE.
 	 */
 	if (ia_valid & ATTR_SIZE) {
-		int error = inode_newsize_ok(inode, attr->ia_size);
+		error = inode_newsize_ok(inode, attr->ia_size);
 		if (error)
-			return error;
+			goto out_attr_exact;
 	}
 
 	/* If force is set do it anyway. */
@@ -181,20 +185,26 @@ int setattr_prepare(struct mnt_idmap *idmap, struct dentry *dentry,
 
 	/* Make sure a caller can chown. */
 	if ((ia_valid & ATTR_UID) &&
-	    !chown_ok(idmap, inode, attr->ia_vfsuid))
-		return -EPERM;
+	    !chown_ok(idmap, inode, attr->ia_vfsuid)) {
+		error = -EPERM;
+		goto out_attr_exact;
+	}
 
 	/* Make sure caller can chgrp. */
 	if ((ia_valid & ATTR_GID) &&
-	    !chgrp_ok(idmap, inode, attr->ia_vfsgid))
-		return -EPERM;
+	    !chgrp_ok(idmap, inode, attr->ia_vfsgid)) {
+		error = -EPERM;
+		goto out_attr_exact;
+	}
 
 	/* Make sure a caller can chmod. */
 	if (ia_valid & ATTR_MODE) {
 		vfsgid_t vfsgid;
 
-		if (!inode_owner_or_capable(idmap, inode))
-			return -EPERM;
+		if (!inode_owner_or_capable(idmap, inode)) {
+			error = -EPERM;
+			goto out_attr_exact;
+		}
 
 		if (ia_valid & ATTR_GID)
 			vfsgid = attr->ia_vfsgid;
@@ -208,11 +218,14 @@ int setattr_prepare(struct mnt_idmap *idmap, struct dentry *dentry,
 
 	/* Check for setting the inode time. */
 	if (ia_valid & (ATTR_MTIME_SET | ATTR_ATIME_SET | ATTR_TIMES_SET)) {
-		if (!inode_owner_or_capable(idmap, inode))
-			return -EPERM;
+		if (!inode_owner_or_capable(idmap, inode)) {
+			error = -EPERM;
+			goto out_attr_exact;
+		}
 	}
 
 kill_priv:
+	inode_end_attr_exact(inode);
 	/* User has permission for the change */
 	if (ia_valid & ATTR_KILL_PRIV) {
 		int error;
@@ -223,6 +236,9 @@ int setattr_prepare(struct mnt_idmap *idmap, struct dentry *dentry,
 	}
 
 	return 0;
+out_attr_exact:
+	inode_end_attr_exact(inode);
+	return error;
 }
 EXPORT_SYMBOL(setattr_prepare);
 
@@ -320,14 +336,61 @@ void setattr_copy(struct mnt_idmap *idmap, struct inode *inode,
 }
 EXPORT_SYMBOL(setattr_copy);
 
-int may_setattr(struct mnt_idmap *idmap, struct inode *inode,
-		unsigned int ia_valid)
+/*
+ * Filesystems with independently published attributes use this gate to make
+ * VFS prechecks join the same serialization as attribute repair. The begin
+ * callback may refresh, then returns with that serialization held.
+ */
+int inode_begin_attr_exact(struct inode *inode)
 {
-	int error;
+	if (inode->i_op->begin_attr_exact)
+		return inode->i_op->begin_attr_exact(inode);
+	return IS_ATTR_EXACT(inode) ? 0 : -EAGAIN;
+}
+EXPORT_SYMBOL(inode_begin_attr_exact);
+
+void inode_end_attr_exact(struct inode *inode)
+{
+	if (inode->i_op->end_attr_exact)
+		inode->i_op->end_attr_exact(inode);
+}
+EXPORT_SYMBOL(inode_end_attr_exact);
+
+int inode_refresh_attr_exact(struct inode *inode)
+{
+	int error = inode_begin_attr_exact(inode);
+
+	if (!error)
+		inode_end_attr_exact(inode);
+	return error;
+}
+EXPORT_SYMBOL(inode_refresh_attr_exact);
+
+int inode_begin_attr_exact_pair(struct inode *inode, struct inode *other)
+{
+	if (inode->i_op->begin_attr_exact_pair)
+		return inode->i_op->begin_attr_exact_pair(inode, other);
+	return IS_ATTR_EXACT(inode) && IS_ATTR_EXACT(other) ? 0 : -EAGAIN;
+}
+EXPORT_SYMBOL(inode_begin_attr_exact_pair);
+
+void inode_end_attr_exact_pair(struct inode *inode, struct inode *other)
+{
+	if (inode->i_op->end_attr_exact_pair)
+		inode->i_op->end_attr_exact_pair(inode, other);
+}
+EXPORT_SYMBOL(inode_end_attr_exact_pair);
+
+static int may_setattr_attr_exact(struct mnt_idmap *idmap,
+				  struct inode *inode, unsigned int ia_valid)
+{
+	int error = 0;
 
 	if (ia_valid & (ATTR_MODE | ATTR_UID | ATTR_GID | ATTR_TIMES_SET)) {
-		if (IS_IMMUTABLE(inode) || IS_APPEND(inode))
-			return -EPERM;
+		if (IS_IMMUTABLE(inode) || IS_APPEND(inode)) {
+			error = -EPERM;
+			goto out;
+		}
 	}
 
 	/*
@@ -335,16 +398,29 @@ int may_setattr(struct mnt_idmap *idmap, struct inode *inode,
 	 * times are UTIME_NOW), then we need to check for write permission
 	 */
 	if (ia_valid & ATTR_TOUCH) {
-		if (IS_IMMUTABLE(inode))
-			return -EPERM;
-
-		if (!inode_owner_or_capable(idmap, inode)) {
-			error = inode_permission(idmap, inode, MAY_WRITE);
-			if (error)
-				return error;
+		if (IS_IMMUTABLE(inode)) {
+			error = -EPERM;
+			goto out;
 		}
+
+		if (!inode_owner_or_capable(idmap, inode))
+			error = inode_permission_attr_exact(idmap, inode,
+							    MAY_WRITE);
 	}
-	return 0;
+out:
+	return error;
+}
+
+int may_setattr(struct mnt_idmap *idmap, struct inode *inode,
+		unsigned int ia_valid)
+{
+	int error = inode_begin_attr_exact(inode);
+
+	if (error)
+		return error;
+	error = may_setattr_attr_exact(idmap, inode, ia_valid);
+	inode_end_attr_exact(inode);
+	return error;
 }
 EXPORT_SYMBOL(may_setattr);
 
@@ -381,16 +457,20 @@ int notify_change(struct mnt_idmap *idmap, struct dentry *dentry,
 	struct fs_reply_publish_scope publish_scope;
 	bool publish_started = false;
 	struct inode *inode = dentry->d_inode;
-	umode_t mode = inode->i_mode;
+	umode_t mode;
 	int error;
 	struct timespec64 now;
 	unsigned int ia_valid = attr->ia_valid;
 
 	WARN_ON_ONCE(!inode_is_locked(inode));
 
-	error = may_setattr(idmap, inode, ia_valid);
+	error = inode_begin_attr_exact(inode);
 	if (error)
 		return error;
+	mode = inode->i_mode;
+	error = may_setattr_attr_exact(idmap, inode, ia_valid);
+	if (error)
+		goto out_attr_exact;
 
 	if ((ia_valid & ATTR_MODE)) {
 		/*
@@ -407,34 +487,16 @@ int notify_change(struct mnt_idmap *idmap, struct dentry *dentry,
 		 * (3) To even do this in the first place one would have to use
 		 *     specific file descriptors and quite some effort.
 		 */
-		if (S_ISLNK(inode->i_mode))
-			return -EOPNOTSUPP;
+		if (S_ISLNK(mode)) {
+			error = -EOPNOTSUPP;
+			goto out_attr_exact;
+		}
 
 		/* Flag setting protected by i_mutex */
 		if (is_sxid(attr->ia_mode))
 			inode->i_flags &= ~S_NOSEC;
 	}
 
-	now = current_time(inode);
-
-	attr->ia_ctime = now;
-	if (!(ia_valid & ATTR_ATIME_SET))
-		attr->ia_atime = now;
-	else
-		attr->ia_atime = timestamp_truncate(attr->ia_atime, inode);
-	if (!(ia_valid & ATTR_MTIME_SET))
-		attr->ia_mtime = now;
-	else
-		attr->ia_mtime = timestamp_truncate(attr->ia_mtime, inode);
-
-	if (ia_valid & ATTR_KILL_PRIV) {
-		error = security_inode_need_killpriv(dentry);
-		if (error < 0)
-			return error;
-		if (error == 0)
-			ia_valid = attr->ia_valid &= ~ATTR_KILL_PRIV;
-	}
-
 	/*
 	 * We now pass ATTR_KILL_S*ID to the lower level setattr function so
 	 * that the function has the ability to reinterpret a mode change
@@ -449,43 +511,74 @@ int notify_change(struct mnt_idmap *idmap, struct dentry *dentry,
 	if (ia_valid & ATTR_KILL_SUID) {
 		if (mode & S_ISUID) {
 			ia_valid = attr->ia_valid |= ATTR_MODE;
-			attr->ia_mode = (inode->i_mode & ~S_ISUID);
+			attr->ia_mode = mode & ~S_ISUID;
 		}
 	}
 	if (ia_valid & ATTR_KILL_SGID) {
 		if (mode & S_ISGID) {
 			if (!(ia_valid & ATTR_MODE)) {
 				ia_valid = attr->ia_valid |= ATTR_MODE;
-				attr->ia_mode = inode->i_mode;
+				attr->ia_mode = mode;
 			}
 			attr->ia_mode &= ~S_ISGID;
 		}
 	}
-	if (!(attr->ia_valid & ~(ATTR_KILL_SUID | ATTR_KILL_SGID)))
-		return 0;
-
 	/*
 	 * Verify that uid/gid changes are valid in the target
 	 * namespace of the superblock.
 	 */
 	if (ia_valid & ATTR_UID &&
 	    !vfsuid_has_fsmapping(idmap, inode->i_sb->s_user_ns,
-				  attr->ia_vfsuid))
-		return -EOVERFLOW;
+				  attr->ia_vfsuid)) {
+		error = -EOVERFLOW;
+		goto out_attr_exact;
+	}
 	if (ia_valid & ATTR_GID &&
 	    !vfsgid_has_fsmapping(idmap, inode->i_sb->s_user_ns,
-				  attr->ia_vfsgid))
-		return -EOVERFLOW;
+				  attr->ia_vfsgid)) {
+		error = -EOVERFLOW;
+		goto out_attr_exact;
+	}
 
 	/* Don't allow modifications of files with invalid uids or
 	 * gids unless those uids & gids are being made valid.
 	 */
 	if (!(ia_valid & ATTR_UID) &&
-	    !vfsuid_valid(i_uid_into_vfsuid(idmap, inode)))
-		return -EOVERFLOW;
+	    !vfsuid_valid(i_uid_into_vfsuid(idmap, inode))) {
+		error = -EOVERFLOW;
+		goto out_attr_exact;
+	}
 	if (!(ia_valid & ATTR_GID) &&
-	    !vfsgid_valid(i_gid_into_vfsgid(idmap, inode)))
-		return -EOVERFLOW;
+	    !vfsgid_valid(i_gid_into_vfsgid(idmap, inode))) {
+		error = -EOVERFLOW;
+		goto out_attr_exact;
+	}
+
+out_attr_exact:
+	inode_end_attr_exact(inode);
+	if (error)
+		return error;
+
+	now = current_time(inode);
+	attr->ia_ctime = now;
+	if (!(ia_valid & ATTR_ATIME_SET))
+		attr->ia_atime = now;
+	else
+		attr->ia_atime = timestamp_truncate(attr->ia_atime, inode);
+	if (!(ia_valid & ATTR_MTIME_SET))
+		attr->ia_mtime = now;
+	else
+		attr->ia_mtime = timestamp_truncate(attr->ia_mtime, inode);
+
+	if (ia_valid & ATTR_KILL_PRIV) {
+		error = security_inode_need_killpriv(dentry);
+		if (error < 0)
+			return error;
+		if (error == 0)
+			ia_valid = attr->ia_valid &= ~ATTR_KILL_PRIV;
+	}
+	if (!(attr->ia_valid & ~(ATTR_KILL_SUID | ATTR_KILL_SGID)))
+		return 0;
 
 	error = security_inode_setattr(idmap, dentry, attr);
 	if (error)
diff --git a/fs/exec.c b/fs/exec.c
index 030240d99..50205980b 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1659,25 +1659,29 @@ static void bprm_fill_uid(struct linux_binprm *bprm, struct file *file)
 	if (task_no_new_privs(current))
 		return;
 
-	mode = READ_ONCE(inode->i_mode);
-	if (!(mode & (S_ISUID|S_ISGID)))
-		return;
-
 	idmap = file_mnt_idmap(file);
 
 	/* Be careful if suid/sgid is set */
 	inode_lock(inode);
+	err = inode_begin_attr_exact(inode);
+	if (err) {
+		inode_unlock(inode);
+		return;
+	}
 
 	/* Atomically reload and check mode/uid/gid now that lock held. */
 	mode = inode->i_mode;
 	vfsuid = i_uid_into_vfsuid(idmap, inode);
 	vfsgid = i_gid_into_vfsgid(idmap, inode);
-	err = inode_permission(idmap, inode, MAY_EXEC);
+	err = inode_permission_attr_exact(idmap, inode, MAY_EXEC);
+	inode_end_attr_exact(inode);
 	inode_unlock(inode);
 
 	/* Did the exec bit vanish out from under us? Give up. */
 	if (err)
 		return;
+	if (!(mode & (S_ISUID|S_ISGID)))
+		return;
 
 	/* We ignore suid/sgid if there are no mappings for them in the ns */
 	if (!vfsuid_has_mapping(bprm->cred->user_ns, vfsuid) ||
diff --git a/fs/fcntl.c b/fs/fcntl.c
index c4cdee6a7..dab8788cc 100644
--- a/fs/fcntl.c
+++ b/fs/fcntl.c
@@ -39,19 +39,22 @@
 static int setfl(int fd, struct file * filp, unsigned int arg)
 {
 	struct inode * inode = file_inode(filp);
-	int error = 0;
+	int error = inode_begin_attr_exact(inode);
+
+	if (error)
+		return error;
 
 	/*
 	 * O_APPEND cannot be cleared if the file is marked as append-only
 	 * and the file is open for write.
 	 */
 	if (((arg ^ filp->f_flags) & O_APPEND) && IS_APPEND(inode))
-		return -EPERM;
+		error = -EPERM;
 
 	/* O_NOATIME can only be set by the owner or superuser */
-	if ((arg & O_NOATIME) && !(filp->f_flags & O_NOATIME))
+	if (!error && (arg & O_NOATIME) && !(filp->f_flags & O_NOATIME))
 		if (!inode_owner_or_capable(file_mnt_idmap(filp), inode))
-			return -EPERM;
+			error = -EPERM;
 
 	/* required for strict SunOS emulation */
 	if (O_NONBLOCK != O_NDELAY)
@@ -59,10 +62,13 @@ static int setfl(int fd, struct file * filp, unsigned int arg)
 		   arg |= O_NONBLOCK;
 
 	/* Pipe packetized mode is controlled by O_DIRECT flag */
-	if (!S_ISFIFO(inode->i_mode) &&
+	if (!error && !S_ISFIFO(inode->i_mode) &&
 	    (arg & O_DIRECT) &&
 	    !(filp->f_mode & FMODE_CAN_ODIRECT))
-		return -EINVAL;
+		error = -EINVAL;
+	inode_end_attr_exact(inode);
+	if (error)
+		return error;
 
 	if (filp->f_op->check_flags)
 		error = filp->f_op->check_flags(arg);
diff --git a/fs/fuse/Makefile b/fs/fuse/Makefile
index ce0ff7a90..93b1b136f 100644
--- a/fs/fuse/Makefile
+++ b/fs/fuse/Makefile
@@ -11,6 +11,7 @@ obj-$(CONFIG_CUSE) += cuse.o
 obj-$(CONFIG_VIRTIO_FS) += virtiofs.o
 
 fuse-y := dev.o dir.o file.o inode.o control.o xattr.o acl.o readdir.o ioctl.o
+fuse-y += post_state.o
 fuse-y += iomode.o
 fuse-$(CONFIG_FUSE_DAX) += dax.o
