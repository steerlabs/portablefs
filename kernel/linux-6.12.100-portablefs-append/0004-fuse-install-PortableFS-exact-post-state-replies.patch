From 80fb41370d0a21e4c4385cd99d17a2b995f9c70c Mon Sep 17 00:00:00 2001
From: Tim Jang <timjang3@gmail.com>
Date: Tue, 18 Aug 2026 03:38:37 -0700
Subject: [PATCH] fuse: install PortableFS exact post-state replies

Signed-off-by: Tim Jang <timjang3@gmail.com>
Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 fs/fuse/Makefile          |   1 +
 fs/fuse/dev.c             | 144 ++++++++-
 fs/fuse/dir.c             | 544 +++++++++++++++++++++++++++++-----
 fs/fuse/file.c            | 122 +++++---
 fs/fuse/fuse_i.h          |  51 +++-
 fs/fuse/inode.c           |  75 ++---
 fs/fuse/post_state.c      | 607 ++++++++++++++++++++++++++++++++++++++
 fs/fuse/readdir.c         | 112 ++++++-
 fs/fuse/xattr.c           |  19 +-
 include/uapi/linux/fuse.h |  71 ++++-
 10 files changed, 1553 insertions(+), 193 deletions(-)
 create mode 100644 fs/fuse/post_state.c

diff --git a/fs/fuse/Makefile b/fs/fuse/Makefile
index ce0ff7a90..93b1b136f 100644
--- a/fs/fuse/Makefile
+++ b/fs/fuse/Makefile
@@ -11,6 +11,7 @@ obj-$(CONFIG_CUSE) += cuse.o
 obj-$(CONFIG_VIRTIO_FS) += virtiofs.o
 
 fuse-y := dev.o dir.o file.o inode.o control.o xattr.o acl.o readdir.o ioctl.o
+fuse-y += post_state.o
 fuse-y += iomode.o
 fuse-$(CONFIG_FUSE_DAX) += dax.o
 fuse-$(CONFIG_FUSE_PASSTHROUGH) += passthrough.o
diff --git a/fs/fuse/dev.c b/fs/fuse/dev.c
index b1078aeb7..f9039eb1b 100644
--- a/fs/fuse/dev.c
+++ b/fs/fuse/dev.c
@@ -15,6 +15,7 @@
 #include <linux/uio.h>
 #include <linux/miscdevice.h>
 #include <linux/pagemap.h>
+#include <linux/posix_acl.h>
 #include <linux/file.h>
 #include <linux/slab.h>
 #include <linux/pipe_fs_i.h>
@@ -695,7 +696,14 @@ ssize_t __fuse_simple_request(struct mnt_idmap *idmap,
 		(args->opcode == FUSE_LOOKUP && ret == -ENOENT);
 	if (!ret && args->out_argvar) {
 		BUG_ON(args->out_numargs == 0);
-		ret = args->out_args[args->out_numargs - 1].size;
+		/*
+		 * Ordinary variable replies return their payload length.  A
+		 * post-state trailer is metadata appended to an otherwise complete
+		 * mutation reply, so its physical length must not become the VFS
+		 * operation result.
+		 */
+		if (!args->pfs_post_state && !args->pfs_cache_stamp)
+			ret = args->out_args[args->out_numargs - 1].size;
 	}
 	if (fc->pfs_strict_coherence &&
 	    ((args->pfs_reply_marked &&
@@ -1803,21 +1811,71 @@ static int fuse_notify_pfs_size(struct fuse_conn *fc, unsigned int size,
 	if (err)
 		goto abort_copy;
 	err = -EPROTO;
-	if (!outarg.nodeid || !outarg.sequence || outarg.sequence > S64_MAX ||
-	    outarg.size > S64_MAX)
+	if (!outarg.object.nodeid || !outarg.visibility_sequence ||
+	    outarg.visibility_sequence > S64_MAX)
 		goto abort_copy;
 	fuse_copy_finish(cs);
 
 	down_read(&fc->killsb);
 	err = -ENOENT;
-	inode = fuse_ilookup(fc, outarg.nodeid, NULL);
+	inode = fuse_ilookup(fc, outarg.object.nodeid, NULL);
 	if (inode) {
+		struct fuse_inode *fi = get_fuse_inode(inode);
+
 		if (!S_ISREG(inode->i_mode) ||
-		    get_fuse_inode(inode)->pfs_class != FUSE_PFS_CLASS_SHARED)
+		    fi->pfs_class != FUSE_PFS_CLASS_SHARED) {
 			err = -EPROTO;
-		else
-			err = fuse_pfs_update_size(inode, outarg.size,
-						   outarg.sequence);
+		} else {
+			mutex_lock(&fi->pfs_publish_mutex);
+			err = fuse_pfs_update_size_locked(inode, &outarg.object,
+						  outarg.visibility_sequence);
+			mutex_unlock(&fi->pfs_publish_mutex);
+		}
+		iput(inode);
+	}
+	up_read(&fc->killsb);
+	if (err && err != -ENOENT)
+		fuse_abort_conn(fc);
+	return err;
+
+abort_copy:
+	fuse_copy_finish(cs);
+	fuse_abort_conn(fc);
+	return err;
+}
+
+static int fuse_notify_pfs_attr(struct fuse_conn *fc, unsigned int size,
+				struct fuse_copy_state *cs)
+{
+	struct fuse_notify_pfs_attr_out outarg;
+	struct fuse_inode *fi;
+	struct inode *inode;
+	int err = -EPROTO;
+
+	if (!fc->pfs_strict_coherence || size != sizeof(outarg))
+		goto abort_copy;
+	err = fuse_copy_one(cs, &outarg, sizeof(outarg));
+	if (err)
+		goto abort_copy;
+	if (!outarg.object.nodeid || !outarg.visibility_sequence ||
+	    outarg.visibility_sequence > S64_MAX) {
+		err = -EPROTO;
+		goto abort_copy;
+	}
+	fuse_copy_finish(cs);
+
+	down_read(&fc->killsb);
+	inode = fuse_pfs_notify_target(fc, outarg.object.nodeid, false);
+	if (IS_ERR(inode)) {
+		err = PTR_ERR(inode);
+	} else if (!inode) {
+		err = -ENOENT;
+	} else {
+		fi = get_fuse_inode(inode);
+		mutex_lock(&fi->pfs_publish_mutex);
+		err = fuse_pfs_install_repair_attr_locked(inode,
+					outarg.visibility_sequence, &outarg.object);
+		mutex_unlock(&fi->pfs_publish_mutex);
 		iput(inode);
 	}
 	up_read(&fc->killsb);
@@ -1831,6 +1889,63 @@ static int fuse_notify_pfs_size(struct fuse_conn *fc, unsigned int size,
 	return err;
 }
 
+static int fuse_notify_pfs_entry(struct fuse_conn *fc, unsigned int size,
+				 struct fuse_copy_state *cs)
+{
+	struct fuse_notify_pfs_entry_out outarg;
+	char *buf;
+	struct qstr name;
+	int err = -ENOMEM;
+
+	buf = kzalloc(FUSE_NAME_MAX + 1, GFP_KERNEL);
+	if (!buf)
+		goto abort_copy;
+	if (!fc->pfs_strict_coherence || size < sizeof(outarg)) {
+		err = -EPROTO;
+		goto abort_buf;
+	}
+	err = fuse_copy_one(cs, &outarg, sizeof(outarg));
+	if (err)
+		goto abort_buf;
+	if (!outarg.parent || !outarg.visibility_sequence ||
+	    outarg.visibility_sequence > S64_MAX || !outarg.namelen ||
+	    outarg.namelen > FUSE_NAME_MAX ||
+	    size != sizeof(outarg) + outarg.namelen ||
+	    (outarg.flags != FUSE_PFS_ENTRY_EXPIRE &&
+	     outarg.flags != FUSE_PFS_ENTRY_DELETE) ||
+	    (outarg.flags == FUSE_PFS_ENTRY_EXPIRE && outarg.child) ||
+	    (outarg.flags == FUSE_PFS_ENTRY_DELETE && !outarg.child)) {
+		err = -EPROTO;
+		goto abort_buf;
+	}
+	err = fuse_copy_one(cs, buf, outarg.namelen);
+	if (err)
+		goto abort_buf;
+	if (!fuse_pfs_notify_name_valid(buf, outarg.namelen)) {
+		err = -EPROTO;
+		goto abort_buf;
+	}
+	fuse_copy_finish(cs);
+	name.name = buf;
+	name.len = outarg.namelen;
+	down_read(&fc->killsb);
+	err = fuse_pfs_reverse_entry(fc, outarg.parent, outarg.child, &name,
+				     outarg.flags,
+				     outarg.visibility_sequence);
+	up_read(&fc->killsb);
+	kfree(buf);
+	if (err && err != -ENOENT)
+		fuse_abort_conn(fc);
+	return err;
+
+abort_buf:
+	kfree(buf);
+abort_copy:
+	fuse_copy_finish(cs);
+	fuse_abort_conn(fc);
+	return err;
+}
+
 static int fuse_notify_inval_entry(struct fuse_conn *fc, unsigned int size,
 				   struct fuse_copy_state *cs)
 {
@@ -2268,10 +2383,9 @@ static int fuse_notify(struct fuse_conn *fc, enum fuse_notify_code code,
 		       unsigned int size, struct fuse_copy_state *cs)
 {
 	if (fc->pfs_strict_coherence &&
-	    code != FUSE_NOTIFY_INVAL_INODE &&
-	    code != FUSE_NOTIFY_INVAL_ENTRY &&
-	    code != FUSE_NOTIFY_DELETE &&
-	    code != FUSE_NOTIFY_PFS_SIZE) {
+	    code != FUSE_NOTIFY_PFS_SIZE &&
+	    code != FUSE_NOTIFY_PFS_ATTR &&
+	    code != FUSE_NOTIFY_PFS_ENTRY) {
 		/* The strict dialect has a closed reverse-notification surface. */
 		fuse_copy_finish(cs);
 		fuse_abort_conn(fc);
@@ -2310,6 +2424,12 @@ static int fuse_notify(struct fuse_conn *fc, enum fuse_notify_code code,
 	case FUSE_NOTIFY_PFS_SIZE:
 		return fuse_notify_pfs_size(fc, size, cs);
 
+	case FUSE_NOTIFY_PFS_ATTR:
+		return fuse_notify_pfs_attr(fc, size, cs);
+
+	case FUSE_NOTIFY_PFS_ENTRY:
+		return fuse_notify_pfs_entry(fc, size, cs);
+
 	default:
 		fuse_copy_finish(cs);
 		return -EINVAL;
diff --git a/fs/fuse/dir.c b/fs/fuse/dir.c
index 7ee120772..d35737f43 100644
--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -184,6 +184,126 @@ static void fuse_lookup_init(struct fuse_conn *fc, struct fuse_args *args,
 	args->out_args[0].value = outarg;
 }
 
+enum fuse_pfs_lookup_shape {
+	FUSE_PFS_LOOKUP_INVALID,
+	FUSE_PFS_LOOKUP_LOCAL_NEGATIVE,
+	FUSE_PFS_LOOKUP_SHARED_NEGATIVE,
+	FUSE_PFS_LOOKUP_LOCAL_POSITIVE,
+	FUSE_PFS_LOOKUP_SHARED_POSITIVE,
+};
+
+struct fuse_pfs_lookup_shape_rule {
+	enum fuse_pfs_lookup_shape shape;
+	bool positive;
+	u32 class_bits;
+	u32 stamp_size;
+	bool marked;
+};
+
+static const struct fuse_pfs_lookup_shape_rule fuse_pfs_lookup_shape_rules[] = {
+	{
+		.shape = FUSE_PFS_LOOKUP_LOCAL_NEGATIVE,
+		.positive = false,
+		.class_bits = FUSE_ATTR_PFS_LOCAL,
+		.stamp_size = 0,
+		.marked = false,
+	},
+	{
+		.shape = FUSE_PFS_LOOKUP_SHARED_NEGATIVE,
+		.positive = false,
+		.class_bits = 0,
+		.stamp_size = sizeof(struct fuse_pfs_cache_stamp),
+		.marked = true,
+	},
+	{
+		.shape = FUSE_PFS_LOOKUP_LOCAL_POSITIVE,
+		.positive = true,
+		.class_bits = FUSE_ATTR_PFS_LOCAL,
+		.stamp_size = 0,
+		.marked = false,
+	},
+	{
+		.shape = FUSE_PFS_LOOKUP_SHARED_POSITIVE,
+		.positive = true,
+		.class_bits = FUSE_ATTR_PFS_SHARED,
+		.stamp_size = sizeof(struct fuse_pfs_cache_stamp),
+		.marked = true,
+	},
+};
+
+static bool fuse_pfs_local_negative_base(const struct fuse_entry_out *outarg)
+{
+	struct fuse_entry_out expected = { };
+
+	expected.attr.flags = FUSE_ATTR_PFS_LOCAL;
+	return !memcmp(outarg, &expected, sizeof(expected));
+}
+
+static bool fuse_pfs_shared_negative_base(const struct fuse_entry_out *outarg)
+{
+	struct fuse_attr expected = { };
+
+	return !outarg->nodeid && !outarg->generation &&
+		!outarg->attr_valid && !outarg->attr_valid_nsec &&
+		outarg->entry_valid_nsec < NSEC_PER_SEC &&
+		!memcmp(&outarg->attr, &expected, sizeof(expected));
+}
+
+static enum fuse_pfs_lookup_shape
+fuse_pfs_classify_lookup_result(struct fuse_mount *fm,
+				struct fuse_args *args,
+				struct fuse_entry_out *outarg)
+{
+	u32 class_bits = outarg->attr.flags &
+		(FUSE_ATTR_PFS_SHARED | FUSE_ATTR_PFS_LOCAL);
+	bool positive = outarg->nodeid != 0;
+	u32 stamp_size;
+	unsigned int i;
+
+	if (args->out_numargs != 2)
+		return FUSE_PFS_LOOKUP_INVALID;
+	stamp_size = args->out_args[1].size;
+
+	for (i = 0; i < ARRAY_SIZE(fuse_pfs_lookup_shape_rules); i++) {
+		const struct fuse_pfs_lookup_shape_rule *rule =
+			&fuse_pfs_lookup_shape_rules[i];
+
+		if (rule->positive != positive ||
+		    rule->class_bits != class_bits ||
+		    rule->stamp_size != stamp_size ||
+		    rule->marked != args->pfs_reply_marked)
+			continue;
+		if (rule->shape == FUSE_PFS_LOOKUP_LOCAL_NEGATIVE &&
+		    !fuse_pfs_local_negative_base(outarg))
+			return FUSE_PFS_LOOKUP_INVALID;
+		if (rule->shape == FUSE_PFS_LOOKUP_SHARED_NEGATIVE &&
+		    !fuse_pfs_shared_negative_base(outarg))
+			return FUSE_PFS_LOOKUP_INVALID;
+		if (positive && fuse_invalid_attr(&outarg->attr))
+			return FUSE_PFS_LOOKUP_INVALID;
+		if (fuse_pfs_require_publication(fm, args, rule->marked))
+			return FUSE_PFS_LOOKUP_INVALID;
+		return rule->shape;
+	}
+	return FUSE_PFS_LOOKUP_INVALID;
+}
+
+static bool fuse_pfs_lookup_shape_shared(enum fuse_pfs_lookup_shape shape)
+{
+	return shape == FUSE_PFS_LOOKUP_SHARED_NEGATIVE ||
+		shape == FUSE_PFS_LOOKUP_SHARED_POSITIVE;
+}
+
+static bool fuse_pfs_lookup_shape_matches_inode(
+		enum fuse_pfs_lookup_shape shape, struct inode *inode)
+{
+	u8 class = get_fuse_inode(inode)->pfs_class;
+
+	if (fuse_pfs_lookup_shape_shared(shape))
+		return class == FUSE_PFS_CLASS_SHARED;
+	return class == FUSE_PFS_CLASS_LOCAL;
+}
+
 /*
  * Check whether the dentry is still valid
  *
@@ -207,8 +327,11 @@ static int fuse_dentry_revalidate(struct dentry *entry, unsigned int flags)
 	else if (time_before64(fuse_dentry_time(entry), get_jiffies_64()) ||
 		 (flags & (LOOKUP_EXCL | LOOKUP_REVAL | LOOKUP_RENAME_TARGET))) {
 		struct fuse_entry_out outarg;
+		struct fuse_pfs_cache_stamp stamp;
 		FUSE_ARGS(args);
 		struct fuse_forget_link *forget;
+		struct inode *parent_inode;
+		enum fuse_pfs_lookup_shape shape = FUSE_PFS_LOOKUP_INVALID;
 		u64 attr_version;
 
 		/* For negative dentries, always do a fresh lookup */
@@ -229,39 +352,56 @@ static int fuse_dentry_revalidate(struct dentry *entry, unsigned int flags)
 		attr_version = fuse_get_attr_version(fm->fc);
 
 		parent = dget_parent(entry);
-		fi = get_fuse_inode(d_inode(parent));
 		fuse_lookup_init(fm->fc, &args, get_node_id(d_inode(parent)),
 				 &entry->d_name, &outarg);
-		if (fm->fc->pfs_strict_coherence)
+		if (fm->fc->pfs_strict_coherence) {
 			args.pfs_publish_policy = FUSE_PFS_PUBLISH_OPTIONAL;
+			args.out_numargs = 2;
+			args.out_args[1].size = sizeof(stamp);
+			args.out_args[1].value = &stamp;
+			args.out_argvar = true;
+			args.pfs_cache_stamp = true;
+		}
 		ret = fuse_simple_request(fm, &args);
+		parent_inode = igrab(d_inode(parent));
 		dput(parent);
-		/* Zero nodeid is same as -ENOENT */
-		if (!ret && !outarg.nodeid)
-			ret = -ENOENT;
-		if (!ret) {
-			u32 class_bits = outarg.attr.flags &
-				(FUSE_ATTR_PFS_SHARED | FUSE_ATTR_PFS_LOCAL);
-
-			if (fm->fc->pfs_strict_coherence &&
-			    (class_bits != FUSE_ATTR_PFS_SHARED &&
-			     class_bits != FUSE_ATTR_PFS_LOCAL)) {
+		if (!parent_inode) {
+			ret = -ESTALE;
+			goto out_revalidate;
+		}
+		if (fm->fc->pfs_strict_coherence && ret == -ENOENT) {
+			fuse_abort_conn(fm->fc);
+			ret = -ENOTCONN;
+			goto out_revalidate;
+		}
+		if (fm->fc->pfs_strict_coherence && !ret) {
+			shape = fuse_pfs_classify_lookup_result(fm, &args, &outarg);
+			if (shape == FUSE_PFS_LOOKUP_INVALID ||
+			    !fuse_pfs_lookup_shape_matches_inode(shape, inode)) {
 				fuse_abort_conn(fm->fc);
-				fuse_queue_forget(fm->fc, forget,
-						  outarg.nodeid, 1);
-				forget = NULL;
+				if (outarg.nodeid) {
+					fuse_queue_forget(fm->fc, forget,
+							  outarg.nodeid, 1);
+					forget = NULL;
+				}
 				ret = -ENOTCONN;
 				goto out_revalidate;
 			}
-			if (fm->fc->pfs_strict_coherence &&
-			    fuse_pfs_require_publication(fm, &args,
-				class_bits == FUSE_ATTR_PFS_SHARED)) {
-				fuse_queue_forget(fm->fc, forget,
-						  outarg.nodeid, 1);
-				forget = NULL;
-				ret = -ENOTCONN;
+			if (!outarg.nodeid) {
+				if (fuse_pfs_lookup_shape_shared(shape) &&
+				    fuse_pfs_install_lookup(parent_inode, NULL,
+							    &outarg, &stamp)) {
+					fuse_abort_conn(fm->fc);
+					ret = -ENOTCONN;
+				} else {
+					ret = -ENOENT;
+				}
 				goto out_revalidate;
 			}
+		}
+		if (!ret && !outarg.nodeid)
+			ret = -ENOENT;
+		if (!ret) {
 			if (outarg.nodeid != get_node_id(inode) ||
 			    (bool) IS_AUTOMOUNT(inode) != (bool) (outarg.attr.flags & FUSE_ATTR_SUBMOUNT)) {
 				fuse_queue_forget(fm->fc, forget,
@@ -283,16 +423,25 @@ static int fuse_dentry_revalidate(struct dentry *entry, unsigned int flags)
 				ret = -ENOTCONN;
 				goto out_revalidate;
 			}
+			if (fm->fc->pfs_strict_coherence &&
+			    fuse_pfs_lookup_shape_shared(shape) &&
+			    fuse_pfs_install_lookup(parent_inode, inode, &outarg,
+						    &stamp)) {
+				fuse_abort_conn(fm->fc);
+				fuse_queue_forget(fm->fc, forget,
+						  outarg.nodeid, 1);
+				forget = NULL;
+				ret = -ENOTCONN;
+				goto out_revalidate;
+			}
 			fi = get_fuse_inode(inode);
 			spin_lock(&fi->lock);
 			fi->nlookup++;
 			spin_unlock(&fi->lock);
 		}
-		if (ret == -ENOENT && fm->fc->pfs_strict_coherence &&
-		    fuse_pfs_require_publication(fm, &args,
-			fi->pfs_class == FUSE_PFS_CLASS_SHARED))
-			ret = -ENOTCONN;
 out_revalidate:
+		if (parent_inode)
+			iput(parent_inode);
 		kfree(forget);
 		if (ret == -ENOMEM || ret == -EINTR || ret == -ENOTCONN)
 			goto out;
@@ -301,8 +450,9 @@ static int fuse_dentry_revalidate(struct dentry *entry, unsigned int flags)
 			goto invalid;
 
 		forget_all_cached_acls(inode);
-		ret = fuse_change_attributes(inode, &outarg.attr, NULL,
-					     ATTR_TIMEOUT(&outarg), attr_version);
+		ret = fm->fc->pfs_strict_coherence ? 0 :
+			fuse_change_attributes(inode, &outarg.attr, NULL,
+					       ATTR_TIMEOUT(&outarg), attr_version);
 		if (ret)
 			goto out;
 		fuse_change_entry_timeout(entry, &outarg);
@@ -408,12 +558,14 @@ bool fuse_invalid_attr(struct fuse_attr *attr)
 }
 
 int fuse_lookup_name(struct super_block *sb, u64 nodeid, const struct qstr *name,
-		     struct fuse_entry_out *outarg, struct inode **inode,
-		     bool pfs_publish)
+		     struct fuse_entry_out *outarg, struct inode **inode)
 {
 	struct fuse_mount *fm = get_fuse_mount_super(sb);
 	FUSE_ARGS(args);
 	struct fuse_forget_link *forget;
+	struct fuse_pfs_cache_stamp stamp;
+	enum fuse_pfs_lookup_shape shape = FUSE_PFS_LOOKUP_INVALID;
+	struct inode *parent = NULL;
 	u64 attr_version;
 	int err;
 
@@ -431,16 +583,54 @@ int fuse_lookup_name(struct super_block *sb, u64 nodeid, const struct qstr *name
 	attr_version = fuse_get_attr_version(fm->fc);
 
 	fuse_lookup_init(fm->fc, &args, nodeid, name, outarg);
-	if (fm->fc->pfs_strict_coherence)
+	if (fm->fc->pfs_strict_coherence) {
 		args.pfs_publish_policy = FUSE_PFS_PUBLISH_OPTIONAL;
+		args.out_numargs = 2;
+		args.out_args[1].size = sizeof(stamp);
+		args.out_args[1].value = &stamp;
+		args.out_argvar = true;
+		args.pfs_cache_stamp = true;
+	}
 	err = fuse_simple_request(fm, &args);
+	if (fm->fc->pfs_strict_coherence && err == -ENOENT) {
+		fuse_abort_conn(fm->fc);
+		err = -ENOTCONN;
+		goto out_put_forget;
+	}
+	if (fm->fc->pfs_strict_coherence && !err) {
+		shape = fuse_pfs_classify_lookup_result(fm, &args, outarg);
+		if (shape == FUSE_PFS_LOOKUP_INVALID) {
+			fuse_abort_conn(fm->fc);
+			if (outarg->nodeid)
+				fuse_queue_forget(fm->fc, forget,
+						  outarg->nodeid, 1);
+			else
+				kfree(forget);
+			forget = NULL;
+			err = -ENOTCONN;
+			goto out;
+		}
+		if (!outarg->nodeid) {
+			if (fuse_pfs_lookup_shape_shared(shape)) {
+				down_read(&fm->fc->killsb);
+				parent = fuse_ilookup(fm->fc, nodeid, NULL);
+				up_read(&fm->fc->killsb);
+				if (!parent || fuse_pfs_install_lookup(parent, NULL,
+								      outarg, &stamp)) {
+					if (parent)
+						iput(parent);
+					fuse_abort_conn(fm->fc);
+					err = -ENOTCONN;
+					goto out_put_forget;
+				}
+				iput(parent);
+			}
+			err = -ENOENT;
+			goto out_put_forget;
