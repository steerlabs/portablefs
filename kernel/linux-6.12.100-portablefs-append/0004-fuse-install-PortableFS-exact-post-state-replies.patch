diff --git a/fs/fuse/post_state.c b/fs/fuse/post_state.c
new file mode 100644
index 000000000..c7fdae5f2
--- /dev/null
+++ b/fs/fuse/post_state.c
@@ -0,0 +1,549 @@
+// SPDX-License-Identifier: GPL-2.0
+/* PortableFS exact post-state reply installation. */
+
+#include "fuse_i.h"
+
+#include <linux/fs.h>
+#include <linux/iversion.h>
+#include <linux/mm.h>
+#include <linux/pagemap.h>
+#include <linux/posix_acl.h>
+#include <linux/sort.h>
+
+#define PFS_ROLE_TARGET		0x0001
+#define PFS_ROLE_PARENT		0x0002
+#define PFS_ROLE_OLD_PARENT	0x0004
+#define PFS_ROLE_NEW_PARENT	0x0008
+#define PFS_ROLE_REMOVED		0x0010
+#define PFS_ROLE_OVERWRITTEN	0x0020
+#define PFS_ROLE_SOURCE		0x0040
+#define PFS_ROLE_DESTINATION	0x0080
+#define PFS_ROLE_CREATED		0x0100
+#define PFS_ROLE_EXCHANGED	0x0200
+#define PFS_ROLE_ALL		0x03ff
+#define PFS_PARENT_ROLES	(PFS_ROLE_PARENT | PFS_ROLE_OLD_PARENT | \
+			 PFS_ROLE_NEW_PARENT)
+#define PFS_ATTR_VALID_NS	60000000000ULL
+
+struct pfs_install_record {
+	struct inode *inode;
+	struct fuse_pfs_object_state *state;
+	u64 prior_version;
+	bool install_attr;
+};
+
+static int pfs_inode_cmp(const void *left, const void *right)
+{
+	const struct pfs_install_record *a = left;
+	const struct pfs_install_record *b = right;
+	u64 an = get_node_id(a->inode);
+	u64 bn = get_node_id(b->inode);
+
+	return (an > bn) - (an < bn);
+}
+
+static bool pfs_role_multiset(const struct fuse_pfs_post_state *state,
+			      const u32 *want, unsigned int count)
+{
+	u32 got[FUSE_PFS_MAX_OBJECTS];
+	u32 sorted[FUSE_PFS_MAX_OBJECTS];
+	unsigned int i, j;
+
+	if (state->header.object_count != count)
+		return false;
+	for (i = 0; i < count; i++) {
+		got[i] = state->objects[i].roles;
+		sorted[i] = want[i];
+	}
+	for (i = 0; i < count; i++)
+		for (j = i + 1; j < count; j++) {
+			if (got[j] < got[i])
+				swap(got[i], got[j]);
+			if (sorted[j] < sorted[i])
+				swap(sorted[i], sorted[j]);
+		}
+	return !memcmp(got, sorted, count * sizeof(got[0]));
+}
+
+static bool pfs_valid_roles(u32 opcode,
+			    const struct fuse_pfs_post_state *state)
+{
+	static const u32 target[] = { PFS_ROLE_TARGET };
+	static const u32 created[] = { PFS_ROLE_CREATED, PFS_ROLE_PARENT };
+	static const u32 existing[] = { PFS_ROLE_TARGET, PFS_ROLE_PARENT };
+	static const u32 linked[] = { PFS_ROLE_TARGET, PFS_ROLE_PARENT };
+	static const u32 removed[] = { PFS_ROLE_REMOVED, PFS_ROLE_PARENT };
+	static const u32 copied_one[] = {
+		PFS_ROLE_SOURCE | PFS_ROLE_DESTINATION,
+	};
+	static const u32 copied_two[] = {
+		PFS_ROLE_SOURCE, PFS_ROLE_DESTINATION,
+	};
+	u32 roles[FUSE_PFS_MAX_OBJECTS];
+	unsigned int count = state->header.object_count;
+	unsigned int i;
+
+	switch (opcode) {
+	case FUSE_SETATTR:
+	case FUSE_OPEN:
+	case FUSE_SETXATTR:
+	case FUSE_REMOVEXATTR:
+	case FUSE_FALLOCATE:
+	case FUSE_PFS_WRITE:
+	case FUSE_PFS_FALLOCATE:
+		return pfs_role_multiset(state, target, ARRAY_SIZE(target));
+	case FUSE_PFS_COPY_FILE_RANGE:
+		return pfs_role_multiset(state, copied_one,
+					 ARRAY_SIZE(copied_one)) ||
+		       pfs_role_multiset(state, copied_two,
+					 ARRAY_SIZE(copied_two));
+	case FUSE_SYMLINK:
+	case FUSE_MKNOD:
+	case FUSE_MKDIR:
+	case FUSE_TMPFILE:
+		return pfs_role_multiset(state, created,
+					 ARRAY_SIZE(created));
+	case FUSE_CREATE:
+		return pfs_role_multiset(state, existing,
+					 ARRAY_SIZE(existing)) ||
+		       pfs_role_multiset(state, created,
+					 ARRAY_SIZE(created));
+	case FUSE_LINK:
+		return pfs_role_multiset(state, linked, ARRAY_SIZE(linked));
+	case FUSE_UNLINK:
+	case FUSE_RMDIR:
+		return pfs_role_multiset(state, removed,
+					 ARRAY_SIZE(removed));
+	case FUSE_RENAME:
+	case FUSE_RENAME2:
+		break;
+	default:
+		return false;
+	}
+
+	if (count < 2 || count > 4)
+		return false;
+	for (i = 0; i < count; i++)
+		roles[i] = state->objects[i].roles;
+	/* Rename validation is identity-independent after roles are merged. */
+	{
+		unsigned int moved = 0, parent = 0, overwritten = 0, exchanged = 0;
+
+		for (i = 0; i < count; i++) {
+			u32 role = roles[i];
+
+			if ((role & (PFS_ROLE_SOURCE | PFS_ROLE_DESTINATION)) ==
+			    (PFS_ROLE_SOURCE | PFS_ROLE_DESTINATION)) {
+				moved++;
+				if (role & PFS_ROLE_EXCHANGED)
+					exchanged++;
+				if (role & ~(PFS_ROLE_SOURCE |
+					     PFS_ROLE_DESTINATION |
+					     PFS_ROLE_EXCHANGED))
+					return false;
+			} else if (role == PFS_ROLE_OVERWRITTEN) {
+				overwritten++;
+			} else if (role == (PFS_ROLE_OLD_PARENT |
+					   PFS_ROLE_NEW_PARENT) ||
+				   role == PFS_ROLE_OLD_PARENT ||
+				   role == PFS_ROLE_NEW_PARENT) {
+				parent++;
+			} else {
+				return false;
+			}
+		}
+		return (moved == 1 && !exchanged && overwritten <= 1 &&
+			(parent == 1 || parent == 2)) ||
+		       (moved == 2 && exchanged == 2 && !overwritten &&
+			(parent == 1 || parent == 2));
+	}
+}
+
+bool fuse_pfs_existing_create(const struct fuse_pfs_post_state *state)
+{
+	static const u32 existing[] = { PFS_ROLE_TARGET, PFS_ROLE_PARENT };
+
+	return pfs_role_multiset(state, existing, ARRAY_SIZE(existing));
+}
+
+void fuse_pfs_post_state_args(struct fuse_args *args,
+			      struct fuse_pfs_post_state *state)
+{
+	unsigned int index = args->out_numargs;
+
+	memset(state, 0, sizeof(*state));
+	if (WARN_ON_ONCE(index >= ARRAY_SIZE(args->out_args)))
+		return;
+	args->out_args[index].size = sizeof(*state);
+	args->out_args[index].value = state;
+	args->out_numargs++;
+	args->out_argvar = true;
+	args->pfs_post_state = true;
+}
+
+static struct inode *pfs_find_inode(struct inode **inodes,
+				    unsigned int count, u64 nodeid)
+{
+	unsigned int i;
+
+	for (i = 0; i < count; i++)
+		if (inodes[i] && get_node_id(inodes[i]) == nodeid)
+			return inodes[i];
+	return NULL;
+}
+
+static int pfs_validate_record(struct fuse_pfs_post_state *state,
+			       unsigned int index, struct inode *inode)
+{
+	struct fuse_pfs_object_state *object = &state->objects[index];
+	struct fuse_inode *fi = get_fuse_inode(inode);
+
+	if (!object->nodeid || !object->object_version ||
+	    object->object_version > state->header.snapshot_sequence ||
+	    !object->roles || object->roles & ~PFS_ROLE_ALL ||
+	    object->record_flags & ~FUSE_PFS_OBJECT_DROP_ATTR ||
+	    fuse_invalid_attr(&object->attr) ||
+	    object->attr.ino != inode->i_ino ||
+	    object->attr.size > inode->i_sb->s_maxbytes ||
+	    object->attr.flags != FUSE_ATTR_PFS_SHARED ||
+	    object->pfs_class != FUSE_PFS_CLASS_SHARED ||
+	    fi->pfs_class != FUSE_PFS_CLASS_SHARED)
+		return -EPROTO;
+	if ((object->attr.mode & S_IFMT) != (inode->i_mode & S_IFMT))
+		return -EPROTO;
+	if (index && memcmp(state->objects[index - 1].stable_identity,
+			    object->stable_identity,
+			    sizeof(object->stable_identity)) >= 0)
+		return -EPROTO;
+	if (fi->pfs_identity_known &&
+	    memcmp(fi->pfs_stable_identity, object->stable_identity,
+		   sizeof(object->stable_identity)))
+		return -EPROTO;
+	return 0;
+}
+
+static void pfs_install_statx_attributes(struct inode *inode, u32 flags)
+{
+	/* VFS i_flags represents and enforces only these statx attributes. */
+	unsigned int preserved = inode->i_flags &
+		~(S_IMMUTABLE | S_APPEND | S_ATTR_INEXACT);
+
+	if (flags & STATX_ATTR_IMMUTABLE)
+		preserved |= S_IMMUTABLE;
+	if (flags & STATX_ATTR_APPEND)
+		preserved |= S_APPEND;
+	inode->i_flags = preserved;
+}
+
+static void pfs_install_exact_attr_locked(struct inode *inode,
+					  s64 birth_time_ns, u32 flags)
+{
+	struct fuse_inode *fi = get_fuse_inode(inode);
+	s64 seconds;
+	s32 nanoseconds;
+
+	seconds = div_s64_rem(birth_time_ns, NSEC_PER_SEC, &nanoseconds);
+	if (nanoseconds < 0) {
+		seconds--;
+		nanoseconds += NSEC_PER_SEC;
+	}
+	fi->i_btime.tv_sec = seconds;
+	fi->i_btime.tv_nsec = nanoseconds;
+	set_bit(FUSE_I_BTIME, &fi->state);
+	fi->pfs_inode_flags = flags;
+	pfs_install_statx_attributes(inode, flags);
+}
+
+#define FUSE_PFS_STATX_ATTRIBUTES \
+	(STATX_ATTR_IMMUTABLE | STATX_ATTR_APPEND | STATX_ATTR_NODUMP | \
+	 STATX_ATTR_ENCRYPTED | STATX_ATTR_VERITY | STATX_ATTR_DAX)
+
+bool fuse_pfs_attr_is_exact(struct inode *inode)
+{
+	struct fuse_inode *fi = get_fuse_inode(inode);
+	bool exact;
+
+	spin_lock(&fi->lock);
+	exact = IS_ATTR_EXACT(inode);
+	spin_unlock(&fi->lock);
+	return exact;
+}
+
+int fuse_pfs_fill_exact_statx(struct inode *inode, struct kstat *stat)
+{
+	struct fuse_inode *fi = get_fuse_inode(inode);
+	int err = 0;
+
+	spin_lock(&fi->lock);
+	if (!IS_ATTR_EXACT(inode)) {
+		err = -EAGAIN;
+	} else {
+		stat->btime = fi->i_btime;
+		stat->result_mask |= STATX_BTIME;
+		stat->attributes = fi->pfs_inode_flags;
+		stat->attributes_mask |= FUSE_PFS_STATX_ATTRIBUTES;
+	}
+	spin_unlock(&fi->lock);
+	return err;
+}
+
+static int pfs_install_stamped_attr(struct inode *inode,
+				    struct fuse_attr *attr, u64 attr_valid,
+				    const struct fuse_pfs_cache_stamp *stamp)
+{
+	struct fuse_inode *fi = get_fuse_inode(inode);
+
+	if (!stamp->object_version ||
+	    stamp->object_version > stamp->snapshot_sequence || stamp->reserved ||
+	    fuse_invalid_attr(attr) || inode_wrong_type(inode, attr->mode) ||
+	    fuse_pfs_classify_attr(get_fuse_conn(inode), inode, attr))
+		return -EPROTO;
+	spin_lock(&fi->lock);
+	if (stamp->object_version < fi->pfs_object_version ||
+	    (stamp->object_version == fi->pfs_object_version &&
+	     (IS_ATTR_EXACT(inode) ||
+	      stamp->object_version < fi->pfs_attr_repair_sequence))) {
+		spin_unlock(&fi->lock);
+		return 1;
+	}
+	fuse_change_attributes_common(inode, attr, NULL, attr_valid, 0);
+	i_size_write(inode, attr->size);
+	pfs_install_exact_attr_locked(inode, stamp->birth_time_ns,
+				      stamp->inode_flags);
+	fi->attr_version = atomic64_inc_return(&get_fuse_conn(inode)->attr_version);
+	fi->pfs_object_version = stamp->object_version;
+	spin_unlock(&fi->lock);
+	return 0;
+}
+
+int fuse_pfs_install_lookup(struct inode *parent, struct inode *inode,
+			    struct fuse_entry_out *entry,
+			    const struct fuse_pfs_cache_stamp *stamp)
+{
+	struct fuse_inode *parent_fi = get_fuse_inode(parent);
+	struct fuse_inode *fi = inode ? get_fuse_inode(inode) : NULL;
+	struct fuse_inode *first = parent_fi;
+	struct fuse_inode *second = fi;
+	struct fuse_attr empty_attr = { };
+	u64 parent_prior, object_prior = 0;
+	int err = 0;
+
+	if (!stamp->snapshot_sequence || stamp->snapshot_sequence > S64_MAX ||
+	    stamp->reserved ||
+	    (!inode && (entry->nodeid || entry->generation ||
+		       entry->attr_valid || entry->attr_valid_nsec ||
+		       entry->entry_valid_nsec >= NSEC_PER_SEC ||
+		       memcmp(&entry->attr, &empty_attr, sizeof(empty_attr)))) ||
+	    (!inode && (stamp->object_version || stamp->birth_time_ns ||
+			 stamp->inode_flags)) ||
+	    (inode && (!stamp->object_version ||
+		       stamp->object_version > stamp->snapshot_sequence)))
+		return -EPROTO;
+	if (second && get_node_id(inode) < get_node_id(parent)) {
+		first = fi;
+		second = parent_fi;
+	}
+	mutex_lock(&first->pfs_publish_mutex);
+	if (second && second != first)
+		mutex_lock(&second->pfs_publish_mutex);
+
+	/* Snapshot every comparison before the first possible store. */
+	spin_lock(&parent_fi->lock);
+	parent_prior = parent_fi->pfs_object_version;
+	spin_unlock(&parent_fi->lock);
+	if (fi) {
+		spin_lock(&fi->lock);
+		object_prior = fi->pfs_object_version;
+		spin_unlock(&fi->lock);
+	}
+	if (stamp->snapshot_sequence <= parent_prior) {
+		entry->entry_valid = 0;
+		entry->entry_valid_nsec = 0;
+	}
+	if (inode && stamp->object_version <= object_prior) {
+		entry->attr_valid = 0;
+		entry->attr_valid_nsec = 0;
+	} else if (inode) {
+		err = pfs_install_stamped_attr(inode, &entry->attr,
+			ATTR_TIMEOUT(entry), stamp);
+		if (err > 0) {
+			entry->attr_valid = 0;
+			entry->attr_valid_nsec = 0;
+			err = 0;
+		}
+	}
+	if (second && second != first)
+		mutex_unlock(&second->pfs_publish_mutex);
+	mutex_unlock(&first->pfs_publish_mutex);
+	return err;
+}
+
+int fuse_pfs_install_getattr(struct inode *inode, struct fuse_attr_out *out,
+			     const struct fuse_pfs_cache_stamp *stamp)
+{
+	struct fuse_inode *fi = get_fuse_inode(inode);
+	int err;
+
+	if (!stamp->snapshot_sequence || stamp->snapshot_sequence > S64_MAX ||
+	    stamp->reserved)
+		return -EPROTO;
+	mutex_lock(&fi->pfs_publish_mutex);
+	err = pfs_install_stamped_attr(inode, &out->attr, ATTR_TIMEOUT(out),
+				       stamp);
+	if (err > 0) {
+		out->attr_valid = 0;
+		out->attr_valid_nsec = 0;
+		err = 0;
+	}
+	mutex_unlock(&fi->pfs_publish_mutex);
+	return err;
+}
+
+int fuse_pfs_install_post_state(struct fuse_mount *fm,
+				struct fuse_args *args,
+				struct fuse_pfs_post_state *state,
+				struct inode **inodes, unsigned int inode_count,
+				struct inode *entry_parent,
+				struct fuse_entry_out *entry,
+				u64 data_nodeid, loff_t data_start,
+				u64 data_length)
+{
+	struct fuse_conn *fc = fm->fc;
+	struct pfs_install_record records[FUSE_PFS_MAX_OBJECTS];
