diff --git a/fs/fuse/dev.c b/fs/fuse/dev.c
index b1078aeb7..209d73eed 100644
--- a/fs/fuse/dev.c
+++ b/fs/fuse/dev.c
@@ -15,6 +15,7 @@
 #include <linux/uio.h>
 #include <linux/miscdevice.h>
 #include <linux/pagemap.h>
+#include <linux/posix_acl.h>
 #include <linux/file.h>
 #include <linux/slab.h>
 #include <linux/pipe_fs_i.h>
@@ -695,7 +696,14 @@ ssize_t __fuse_simple_request(struct mnt_idmap *idmap,
 		(args->opcode == FUSE_LOOKUP && ret == -ENOENT);
 	if (!ret && args->out_argvar) {
 		BUG_ON(args->out_numargs == 0);
-		ret = args->out_args[args->out_numargs - 1].size;
+		/*
+		 * Ordinary variable replies return their payload length.  A
+		 * post-state trailer is metadata appended to an otherwise complete
+		 * mutation reply, so its physical length must not become the VFS
+		 * operation result.
+		 */
+		if (!args->pfs_post_state && !args->pfs_cache_stamp)
+			ret = args->out_args[args->out_numargs - 1].size;
 	}
 	if (fc->pfs_strict_coherence &&
 	    ((args->pfs_reply_marked &&
@@ -1812,13 +1820,90 @@ static int fuse_notify_pfs_size(struct fuse_conn *fc, unsigned int size,
 	err = -ENOENT;
 	inode = fuse_ilookup(fc, outarg.nodeid, NULL);
 	if (inode) {
+		struct fuse_inode *fi = get_fuse_inode(inode);
+
 		if (!S_ISREG(inode->i_mode) ||
-		    get_fuse_inode(inode)->pfs_class != FUSE_PFS_CLASS_SHARED)
+		    fi->pfs_class != FUSE_PFS_CLASS_SHARED) {
 			err = -EPROTO;
-		else
-			err = fuse_pfs_update_size(inode, outarg.size,
-						   outarg.sequence);
+		} else {
+			mutex_lock(&fi->pfs_publish_mutex);
+			spin_lock(&fi->lock);
+			fi->pfs_repairing = true;
+			spin_unlock(&fi->lock);
+			err = fuse_pfs_update_size_locked(inode, outarg.size,
+						  outarg.sequence);
+			spin_lock(&fi->lock);
+			if (!err)
+				fi->pfs_object_version =
+					max(fi->pfs_object_version,
+					    outarg.sequence);
+			fi->pfs_repairing = false;
+			spin_unlock(&fi->lock);
+			mutex_unlock(&fi->pfs_publish_mutex);
+		}
+		iput(inode);
+	}
+	up_read(&fc->killsb);
+	if (err && err != -ENOENT)
+		fuse_abort_conn(fc);
+	return err;
+
+abort_copy:
+	fuse_copy_finish(cs);
+	fuse_abort_conn(fc);
+	return err;
+}
+
+static int fuse_notify_pfs_attr(struct fuse_conn *fc, unsigned int size,
+				struct fuse_copy_state *cs)
+{
+	struct fuse_notify_pfs_attr_out outarg;
+	struct fuse_inode *fi;
+	struct inode *inode;
+	int err = -EPROTO;
+
+	if (!fc->pfs_strict_coherence || size != sizeof(outarg))
+		goto abort_copy;
+	err = fuse_copy_one(cs, &outarg, sizeof(outarg));
+	if (err)
+		goto abort_copy;
+	if (!outarg.nodeid || !outarg.visibility_sequence ||
+	    outarg.visibility_sequence > S64_MAX) {
+		err = -EPROTO;
+		goto abort_copy;
+	}
+	fuse_copy_finish(cs);
+
+	down_read(&fc->killsb);
+	inode = fuse_pfs_notify_target(fc, outarg.nodeid, false);
+	if (IS_ERR(inode)) {
+		err = PTR_ERR(inode);
+	} else if (!inode) {
+		err = -ENOENT;
+	} else {
+		fi = get_fuse_inode(inode);
+		mutex_lock(&fi->pfs_publish_mutex);
+		spin_lock(&fi->lock);
+		fi->pfs_repairing = true;
+		spin_unlock(&fi->lock);
+		forget_all_cached_acls(inode);
+		fuse_invalidate_attr(inode);
+		spin_lock(&fi->lock);
+		clear_bit(FUSE_I_BTIME, &fi->state);
+		fi->pfs_inode_flags = 0;
+		inode->i_flags &= ~(S_IMMUTABLE | S_APPEND);
+		inode->i_flags |= S_ATTR_INEXACT;
+		fi->attr_version = atomic64_inc_return(&fc->attr_version);
+		fi->pfs_object_version = max(fi->pfs_object_version,
+					     outarg.visibility_sequence);
+		fi->pfs_attr_repair_sequence =
+			max(fi->pfs_attr_repair_sequence,
+			    outarg.visibility_sequence);
+		fi->pfs_repairing = false;
+		spin_unlock(&fi->lock);
+		mutex_unlock(&fi->pfs_publish_mutex);
 		iput(inode);
+		err = 0;
 	}
 	up_read(&fc->killsb);
 	if (err && err != -ENOENT)
@@ -1831,6 +1916,63 @@ static int fuse_notify_pfs_size(struct fuse_conn *fc, unsigned int size,
 	return err;
 }
 
+static int fuse_notify_pfs_entry(struct fuse_conn *fc, unsigned int size,
+				 struct fuse_copy_state *cs)
+{
+	struct fuse_notify_pfs_entry_out outarg;
+	char *buf;
+	struct qstr name;
+	int err = -ENOMEM;
+
+	buf = kzalloc(FUSE_NAME_MAX + 1, GFP_KERNEL);
+	if (!buf)
