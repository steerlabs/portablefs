+				struct fuse_args *args,
+				struct fuse_entry_out *outarg)
+{
+	u32 class_bits = outarg->attr.flags &
+		(FUSE_ATTR_PFS_SHARED | FUSE_ATTR_PFS_LOCAL);
+	bool positive = outarg->nodeid != 0;
+	u32 stamp_size;
+	unsigned int i;
