+		if (!record->namelen || record->namelen > FUSE_NAME_MAX ||
+		    reclen > nbytes || memchr(record->name, '/',
+					     record->namelen)) {
+			fuse_abort_conn(get_fuse_conn(file_inode(file)));
+			return -ENOTCONN;
+		}
+		if (!over) {
+			over = !dir_emit(ctx, record->name, record->namelen,
+					 record->ino, record->type);
+			if (!over)
