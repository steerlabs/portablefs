# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG GO_IMAGE=golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36
ARG UBUNTU_IMAGE=ubuntu:24.04@sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea
ARG SOURCE_REVISION

FROM ${GO_IMAGE} AS build
ARG SOURCE_REVISION
WORKDIR /source
COPY vcs/go.mod vcs/go.sum ./vcs/
COPY vcs/third_party/go-fuse ./vcs/third_party/go-fuse
RUN --mount=type=cache,id=portablefs-files-go-mod,target=/go/pkg/mod go -C vcs mod download
COPY vcs ./vcs
RUN --mount=type=cache,id=portablefs-files-go-build,target=/root/.cache/go-build \
    CGO_ENABLED=0 go -C vcs build -trimpath -ldflags='-s -w -buildid=' \
      -o /output/portablefs-files ./cmd/portablefs-files
RUN printf '%s\n' "$SOURCE_REVISION" | grep -Eq '^[0-9a-f]{40}$' && \
    test "$SOURCE_REVISION" != 0000000000000000000000000000000000000000 && \
    printf '{"schemaVersion":1,"sourceRevision":"%s"}\n' "$SOURCE_REVISION" \
      >/output/release.json && \
    chmod 0444 /output/release.json

FROM ${UBUNTU_IMAGE}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/steerlabs/portablefs" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.version="$SOURCE_REVISION" \
      io.opensteer.portablefs.release-record="/usr/local/share/portablefs/release.json"
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && \
    apt-get install --yes --no-install-recommends ca-certificates curl tini && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 200102 portablefs-files && \
    useradd --system --uid 200102 --gid 200102 --home-dir /var/lib/portablefs-files \
      --shell /usr/sbin/nologin portablefs-files && \
    install --directory --owner 200102 --group 200102 --mode 0700 /var/lib/portablefs-files && \
    install --directory --owner root --group root --mode 0755 /request-trust && \
    install --directory --owner root --group root --mode 0755 /usr/local/share/portablefs
COPY --from=build --chmod=0555 /output/portablefs-files /usr/local/bin/portablefs-files
COPY --from=build --chmod=0444 /output/release.json /usr/local/share/portablefs/release.json
WORKDIR /
USER 200102:200102
EXPOSE 4315
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/portablefs-files"]
