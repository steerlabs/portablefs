[Unit]
Description=PortableFS outbound cell agent for cell %i
Wants=network-online.target
After=network-online.target portablefs-cell-helper@%i.service
Requires=portablefs-cell-helper@%i.service

[Service]
Type=simple
EnvironmentFile=/etc/portablefs/cells/%i.env
ExecStart=/opt/portablefs/current/bin/portablefs-cell-agent -cell-id %i -manager-url ${PORTABLEFS_MANAGER_URL} -manager-server-name ${PORTABLEFS_MANAGER_SERVER_NAME} -tls-cert /etc/portablefs/cells/%i.cert -tls-key /etc/portablefs/cells/%i.key -manager-ca /etc/portablefs/trust/manager-ca.pem -plan-public-key /etc/portablefs/trust/plan-public.pem -helper-socket /run/portablefs-cell-helper/%i.sock
Restart=always
RestartSec=3s
User=portablefs-agent
Group=portablefs-agent
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @debug @module @mount @obsolete @raw-io @reboot @swap bpf io_uring_setup keyctl perf_event_open ptrace userfaultfd
UMask=0077
TasksMax=128
MemoryMax=256M
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
