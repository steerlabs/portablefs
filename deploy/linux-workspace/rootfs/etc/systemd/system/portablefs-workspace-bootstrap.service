[Unit]
Description=PortableFS VM-bound seed and persistent data initialization
After=local-fs.target dev-vdb.device dev-hvc1.device
Requires=dev-vdb.device dev-hvc1.device
[Service]
Type=oneshot
ExecStart=/usr/local/bin/portablefs-workspaced bootstrap
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
