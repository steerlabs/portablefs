[Unit]
Description=PortableFS VM-bound boot identity and SSH public material
Requires=portablefs-workspace-data.service portablefs-workspace-fuse-probe.service
After=portablefs-workspace-data.service portablefs-workspace-fuse-probe.service dev-hvc1.device
Requires=dev-hvc1.device
[Service]
Type=oneshot
ExecStart=/usr/local/bin/portablefs-workspaced bootstrap
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
