VOLUME_DATABASE_URL=postgres://postgres:postgres@localhost:5432/portablefs

# Fill these from:
# railway bucket credentials --bucket portablefs-blobs --json
AWS_ENDPOINT_URL=https://t3.storageapi.dev
AWS_S3_BUCKET_NAME=portablefs-blobs-xxxxxx
AWS_DEFAULT_REGION=auto
AWS_S3_URL_STYLE=virtual-host
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
VOLUME_S3_PREFIX=portablefs/dev
