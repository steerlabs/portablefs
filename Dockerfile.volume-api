# node:22-bookworm
FROM node:26-bookworm@sha256:219fc9da91e7f29a9f32290ff598cdf8886fd68f421ff515c8f93434da39a271 AS build
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/volume-api/package.json apps/volume-api/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/metadata-db/package.json packages/metadata-db/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/storage-filesystem/package.json packages/storage-filesystem/package.json
COPY packages/storage-s3/package.json packages/storage-s3/package.json
RUN pnpm install --frozen-lockfile --filter @portablefs/volume-api...

COPY apps/volume-api apps/volume-api
COPY packages/core packages/core
COPY packages/metadata-db packages/metadata-db
COPY packages/protocol packages/protocol
COPY packages/storage-filesystem packages/storage-filesystem
COPY packages/storage-s3 packages/storage-s3
RUN pnpm --filter @portablefs/volume-api... build

# node:22-bookworm-slim
FROM node:26-bookworm-slim@sha256:2d49d876e96237d76de412761cf05dbfe5aee325cc4406a4d41d5824c5bb8beb AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/volume-api/package.json apps/volume-api/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/metadata-db/package.json packages/metadata-db/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/storage-filesystem/package.json packages/storage-filesystem/package.json
COPY packages/storage-s3/package.json packages/storage-s3/package.json
RUN pnpm install --prod --frozen-lockfile --filter @portablefs/volume-api...

COPY --from=build /app/apps/volume-api/dist apps/volume-api/dist
COPY --from=build /app/packages/core/dist packages/core/dist
COPY --from=build /app/packages/metadata-db/dist packages/metadata-db/dist
COPY --from=build /app/packages/metadata-db/migrations packages/metadata-db/migrations
COPY --from=build /app/packages/metadata-db/migrations packages/migrations
COPY --from=build /app/packages/protocol/dist packages/protocol/dist
COPY --from=build /app/packages/storage-filesystem/dist packages/storage-filesystem/dist
COPY --from=build /app/packages/storage-s3/dist packages/storage-s3/dist

# Inert copy for the migration gate: nothing in this image executes it (CMD
# below is unchanged). It exists so railway/migration-gate.railway.json can
# run `node /app/scripts/run-migration-gate.mjs` as a one-shot pre-deploy job
# from this same runtime image — the script resolves
# packages/metadata-db/dist (and its `pg` dependency) and the shipped
# migrations relative to its own location, and all are already present above.
COPY scripts/run-migration-gate.mjs scripts/run-migration-gate.mjs

# Exact release identity baked by release tooling (served at
# /v1/release-identity). Unset for local builds: the route answers 404, the
# honest "unpinned dev image" signal.
ARG PORTABLEFS_RELEASE_ID=""
ARG PORTABLEFS_SOURCE_REVISION=""
ENV PORTABLEFS_RELEASE_ID=${PORTABLEFS_RELEASE_ID} \
    PORTABLEFS_SOURCE_REVISION=${PORTABLEFS_SOURCE_REVISION}

# Run as the unprivileged node user. The blob root is created and chowned
# BEFORE USER so a FRESH named volume mounted at /data/blobs inherits
# node-writable ownership (docker copies the image mountpoint's owner/mode
# into a new volume). history/ belongs to uid 10001 — the dedicated
# `portablefs` user in Dockerfile.history-worker, which WRITES cuts there
# when both services share one blob volume (docker-compose.quickstart.yml);
# this image only READS it for /v1/history serving (0644 objects). /app
# stays root-owned on purpose: the runtime only reads code, and
# non-writable code is the stronger posture.
RUN mkdir -p /data/blobs/history \
    && chown -R node:node /data \
    && chown 10001:10001 /data/blobs/history

ENV NODE_ENV=production
WORKDIR /app/apps/volume-api
USER node
EXPOSE 8787

CMD ["node", "dist/main.js"]
